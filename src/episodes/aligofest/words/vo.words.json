[{"start": 1.3200000000000005, "end": 4.96, "text": " On accueille le plus grand événement d'alégo du monde à Toulouse.", "words": [{"w": " On", "s": 1.3200000000000005, "e": 1.84}, {"w": " accueille", "s": 1.84, "e": 2.18}, {"w": " le", "s": 2.18, "e": 2.34}, {"w": " plus", "s": 2.34, "e": 2.54}, {"w": " grand", "s": 2.54, "e": 2.66}, {"w": " événement", "s": 2.66, "e": 2.96}, {"w": " d", "s": 2.96, "e": 3.1}, {"w": "'alégo", "s": 3.1, "e": 3.26}, {"w": " du", "s": 3.26, "e": 3.44}, {"w": " monde", "s": 3.44, "e": 3.78}, {"w": " à", "s": 3.78, "e": 4.28}, {"w": " Toulouse.", "s": 4.28, "e": 4.96}]}, {"start": 5.26, "end": 10.12, "text": " 4 tonnes ont été servies, alégo saucisse à volonté pour tout le monde.", "words": [{"w": " 4", "s": 5.26, "e": 5.48}, {"w": " tonnes", "s": 5.48, "e": 5.64}, {"w": " ont", "s": 5.64, "e": 5.78}, {"w": " été", "s": 5.78, "e": 5.96}, {"w": " servies,", "s": 5.96, "e": 6.9}, {"w": " alégo", "s": 7.16, "e": 7.38}, {"w": " saucisse", "s": 7.38, "e": 7.76}, {"w": " à", "s": 7.76, "e": 8.0}, {"w": " volonté", "s": 8.0, "e": 8.56}, {"w": " pour", "s": 8.56, "e": 8.8}, {"w": " tout", "s": 8.8, "e": 8.94}, {"w": " le", "s": 8.94, "e": 10.12}, {"w": " monde.", "s": 10.12, "e": 10.12}]}, {"start": 10.64, "end": 15.1, "text": " Sinon moi c'est Harry, l'influencer en carton, et je vous partage les bons plans", "words": [{"w": " Sinon", "s": 10.64, "e": 10.84}, {"w": " moi", "s": 10.84, "e": 11.12}, {"w": " c", "s": 11.12, "e": 11.34}, {"w": "'est", "s": 11.34, "e": 11.44}, {"w": " Harry,", "s": 11.44, "e": 11.92}, {"w": " l", "s": 12.28, "e": 12.54}, {"w": "'influencer", "s": 12.54, "e": 12.8}, {"w": " en", "s": 12.8, "e": 13.0}, {"w": " carton,", "s": 13.0, "e": 13.74}, {"w": " et", "s": 13.98, "e": 14.02}, {"w": " je", "s": 14.02, "e": 14.1}, {"w": " vous", "s": 14.1, "e": 14.22}, {"w": " partage", "s": 14.22, "e": 14.52}, {"w": " les", "s": 14.52, "e": 14.72}, {"w": " bons", "s": 14.72, "e": 14.88}, {"w": " plans", "s": 14.88, "e": 15.1}]}, 