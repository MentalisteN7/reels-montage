1, "e": 31.3}, {"w": " du", "s": 31.3, "e": 31.5}, {"w": " monde.", "s": 31.5, "e": 31.94}]}, {"start": 32.76, "end": 37.72, "text": " Fier d'être Toulousain, il y avait un beer pong, plein d'activités et des cookies à", "words": [{"w": " Fier", "s": 32.76, "e": 32.92}, {"w": " d", "s": 32.92, "e": 33.02}, {"w": "'être", "s": 33.02, "e": 33.12}, {"w": " Toulousain,", "s": 33.12, "e": 33.54}, {"w": " il", "s": 34.68, "e": 34.92}, {"w": " y", "s": 34.92, "e": 35.04}, {"w": " avait", "s": 35.04, "e": 35.16}, {"w": " un", "s": 35.16, "e": 35.36}, {"w": " beer", "s": 35.36, "e": 35.54}, {"w": " pong,", "s": 35.54, "e": 35.82}, {"w": " plein", "s": 36.08, "e": 36.18}, {"w": " d", "s": 36.18, "e": 36.38}, {"w": "'activités", "s": 36.38, "e": 36.82}, {"w": " et", "s": 36.82, "e": 37.06}, {"w": " des", "s": 37.06, "e": 37.22}, {"w": " cookies", "s": 37.22, "e": 37.48}, {"w": " à", "s": 37.48, "e": 37.72}]}, {"start": 37.72, "end": 38.18, "text": " l'alégo.", "words": [{"w": " l", "s": 37.72, "e": 37.82}, {"w": "'alégo.", "s": 37.82, "e": 38.18}]}, {"start": 39.480000000000004, "end": 44.8, "text": " Bref, on démarre la compète, prêt à attaquer, on a été servis direct 0 seconde", "words": [{"w": " Bref,", "s": 39.480000000000004, "e": 39.96}, {"w": " on", "s": 40.64, "e": 40.72}, {"w": " démarre", "s": 40.72, "e": 40.9}, {"w": " la", "s": 40.9, "e": 41.1}, {"w": " compète,", "s": 41.1, "e": 41.46}, {"w": " prêt", "s": 41.74, "e": 41.84}, {"w": " à", "s": 41.84, "e": 41.98}, {"w": " attaquer,", "s": 41.98, "e": 42.68}, {"w": " on", "s": 43.04, "e": 43.18}, {"w": " a", "s": 43.18, "e": 43.3}, {"w": " été", "s": 43.3, "e": 43.48}, {"w": " servis", "s": 43.48, "e": 43.74}, {"w": " direct", "s": 43.74, "e": 44.16}, {"w": " 0", "s": 44.16, "e": 44.48}, {"w": " seconde", "s": 44.48, "e": 44.8}]}, {"start": 44.8, "end": 45.2, "text": " d'attente.", "words": [{"w": " d", "s": 44.8, "e": 44.88}, {"w": "'attente.", "s": 44.88, "e": 45.2}]}, {"start": 46.12, "end": 50.4, "text": " La saucisse était bonne et l'alégo passait très bien.", "words": [{"w": " La", "s": 46.12, "e": 46.28}, {"w": " saucisse", "s": 46.28, "e": 46.48}, {"w": " était", "s": 46.48, "e": 48.4}, {"w": " bonne", "s": 48.4, "e": 48.66}, {"w": " et", "s": 48.66, "e": 49.22}, {"w": " l", "s": 49.22, "e": 49.34}, {"w": "'alégo", "s": 49.34, "e": 49.6}, {"w": " passait", "s": 49.6, "e": 50.04}, {"w": " très", "s": 50.04, "e": 50.28}, {"w": " bien.", "s": 50.28, "e": 50.4}]}, {"start": 52.28, "end": 60.6, "text": " On enchaîne direct avec la deuxième assiette pour 20 secondes d'attente, ça a laissé", "words": [{"w": " On", "s": 52.28, "e": 52.76}, {"w": " enchaîne", "s": 52.76, "e": 53.02}, {"w": " direct", "s": 53.02, "e": 55.1}, {"w": " avec", "s": 55.1, "e": 55.36}, {"w": " la", "s": 55.36, "e": 55.58}, {"w": " deuxième", "s": 55.58, "e": 55.84}, {"w": " assiette", "s": 55.84, "e": 56.26}, {"w": " pour", "s": 56.26, "e": 56.58}, {"w": " 20", "s": 56.58, "e": 56.74}, {"w": " secondes", "s": 56.74, "e": 56.98}, {"w": " d", "s": 56.98, "e": 57.12}, {"w": "'attente,", "s": 57.12, "e": 58.56}, {"w": " ça", "s": 59.12, "e": 59.12}, {"w": " a", "s": 59.12, "e": 60.4}, {"w": " laissé", "s": 60.4, "e": 60.6}]}, {"start": 60.6, "end": 61.519999999999996, "text": " le temps de digérer.", "words": [{"w": " le", "s": 60.6, "e": 60.7}, {"w": " temps", "s": 60.7, "e": 60.86}, {"w": " de", "s": 60.86, "e": 61.16}, {"w": " digérer.", "s": 61.16, "e": 61.519999999999996}]}, {"start": 63.54, "end": 66.12, "text": " L'astuce avec l'alégo c'est de le manger tant que c'est chaud.", "words": [{"w": " L", "s": 63.54, "e": 63.64}, {"w": "'astuce", "s": 63.64, "e": 63.92}, {"w": " avec", "s": 63.92, "e": 64.16}, {"w": " l", "s": 64.16, "e": 64.34}, {"w": "'alégo", "s": 64.34, "e": 64.62}, {"w": " c", "s": 64.62, "e": 64.82}, {"w": "'est", "s": 64.82, "e": 64.84}, {"w": " de", "s": 64.84, "e": 65.02}, {"w": " le", "s": 65.02, "e": 65.16}, {"w": " manger", "s": 65.16, "e": 65.4}, {"w": " tant", "s": 65.4, "e": 65.66}, {"w": " que", "s": 65.66, "e": 65.72}, {"w": " c", "s": 65.72, "e": 65.86}, {"w": "'est", "s": 65.86, "e": 65.86}, {"w": " chaud.", "s": 65.86, "e": 66.12}]}, {"start": 67.14, "end": 69.2, "text": " La troisième assiette, ils ont voulu nous achever.", "words": [{"w": " La", "s": 67.14, "e": 67.28}, {"w": " troisième", "s": 67.28, "e": 67.54}, {"w": " assiette,", "s": 67.54, "e": 68.04}, {"w": " ils", "s": 68.04, "e": 68.22}, {"w": " ont", "s": 68.22, "e": 68.34}, {"w": " voulu", "s": 68.34, "e": 68.46}, {"w": " nous", "s": 68.46, "e": 68.8}, {"w": " achever.", "s": 68.8, "e": 69.2}]}, {"start": 69.76, "end": 74.32, "text": " Il y avait le double, l'assiette pesait 1 kg, mais c'était super filant, un vrai", "words": [{"w": " Il", "s": 69.76, "e": 69.86}, {"w": " y", "s": 69.86, "e": 69.92}, {"w": " avait", "s": 69.92, "e": 70.0}, {"w": " le", "s": 70.0, "e": 70.2}, {"w": " double,", "s": 70.2, "e": 70.36}, {"w": " l", "s": 70.54, "e": 70.68}, {"w": "'assiette", "s": 70.68, "e": 70.84}, {"w": " pesait", "s": 70.84, "e": 71.28}, {"w": " 1", "s": 71.28, "e": 71.52}, {"w": " kg,", "s": 71.52, "e": 71.76}, {"w": " mais", "s": 72.32, "e": 72.82}, {"w": " c", "s": 72.82, "e": 73.0}, {"w": "'était", "s": 73.0, "e": 73.14}, {"w": " super", "s": 73.14, "e": 73.52}, {"w": " filant,", "s": 73.52, "e": 73.82}, {"w": " un", "s": 74.08, "e": 74.18}, {"w": " vrai", "s": 74.18, "e": 74.32}]}, {"start": 74.32, "end": 74.82, "text": " délice.", "words": [{"w": " délice.", "s": 74.32, "e": 74.82}]}, {"start": 75.34, "end": 77.9, "text": " On a malheureusement perdu Marie sur le chemin.", "words": [{"w": " On", "s": 75.34, "e": 75.78}, {"w": " a", "s": 75.78, "e": 75.9}, {"w": " malheureusement", "s": 75.9, "e": 76.22}, {"w": " perdu", "s": 76.22, "e": 76.52}, {"w": " Marie", "s": 76.52, "e": 76.82}, {"w": " sur", "s": 76.82, "e": 77.02}, {"w": " le", "s": 77.02, "e": 77.18}, {"w": " chemin.", "s": 77.18, "e": 77.9}]}, {"start": 78.8, "end": 81.0, "text": "(reprise)", "words": [