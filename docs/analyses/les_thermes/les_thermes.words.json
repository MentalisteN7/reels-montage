 19.98}, {"w": " de", "s": 19.98, "e": 20.26}, {"w": " nouvelles", "s": 20.26, "e": 20.38}, {"w": " saveurs.", "s": 20.38, "e": 20.72}]}, {"start": 20.8, "end": 23.16, "text": " C'est parti pour demander l'avis d'un client plutôt beau gosse.", "words": [{"w": " C", "s": 20.8, "e": 20.92}, {"w": "'est", "s": 20.92, "e": 21.0}, {"w": " parti", "s": 21.0, "e": 21.2}, {"w": " pour", "s": 21.2, "e": 21.4}, {"w": " demander", "s": 21.4, "e": 21.68}, {"w": " l", "s": 21.68, "e": 21.84}, {"w": "'avis", "s": 21.84, "e": 21.92}, {"w": " d", "s": 21.92, "e": 22.04}, {"w": "'un", "s": 22.04, "e": 22.14}, {"w": " client", "s": 22.14, "e": 22.5}, {"w": " plutôt", "s": 22.5, "e": 22.8}, {"w": " beau", "s": 22.8, "e": 22.94}, {"w": " gosse.", "s": 22.94, "e": 23.16}]}, {"start": 23.24, "end": 24.7, "text": " Eh, eh, eh, eh !", "words": [{"w": " Eh,", "s": 23.24, "e": 23.44}, {"w": " eh,", "s": 23.78, "e": 23.86}, {"w": " eh,", "s": 24.04, "e": 24.32}, {"w": " eh", "s": 24.54, "e": 24.7}, {"w": " !", "s": 24.7, "e": 24.7}]}, {"start": 24.7, "end": 26.02, "text": " Alors, vous en pensez quoi ?", "words": [{"w": " Alors,", "s": 24.7, "e": 25.24}, {"w": " vous", "s": 25.34, "e": 25.38}, {"w": " en", "s": 25.38, "e": 25.46}, {"w": " pensez", "s": 25.46, "e": 25.74}, {"w": " quoi", "s": 25.74, "e": 25.84}, {"w": " ?", "s": 25.84, "e": 26.02}]}, {"start": 26.02, "end": 28.66, "text": " Bah écoute, c'était super bon, incroyable, trop bonne découverte.", "words": [{"w": " Bah", "s": 26.02, "e": 26.24}, {"w": " écoute,", "s": 26.24, "e": 26.42}, {"w": " c", "s": 26.42, "e": 26.56}, {"w": "'était", "s": 26.56, "e": 26.64}, {"w": " super", "s": 26.64, "e": 27.06}, {"w": " bon,", "s": 27.06, "e": 27.14}, {"w": " incroyable,", "s": 27.18, "e": 27.68}, {"w": " trop", "s": 27.84, "e": 27.98}, {"w": " bonne", "s": 27.98, "e": 28.1}, {"w": " découverte.", "s": 28.1, "e": 28.66}]}, {"start": 28.66, "end": 31.16, "text": " Surtout pour le plat, j'ai pris un biaang biaang là,", "words": [{"w": " Surtou