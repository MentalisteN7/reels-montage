[{"start": 0.0, "end": 3.56, "text": " Les célèbres nouilles de 2 mètres à la Côte de Beuf reviennent enfin à Toulouse,", "words": [{"w": " Les", "s": 0.0, "e": 0.34}, {"w": " célèbres", "s": 0.34, "e": 0.74}, {"w": " nouilles", "s": 0.74, "e": 0.94}, {"w": " de", "s": 0.94, "e": 1.14}, {"w": " 2", "s": 1.14, "e": 1.36}, {"w": " mètres", "s": 1.36, "e": 1.6}, {"w": " à", "s": 1.6, "e": 1.84}, {"w": " la", "s": 1.84, "e": 1.96}, {"w": " Côte", "s": 1.96, "e": 2.08}, {"w": " de", "s": 2.08, "e": 2.26}, {"w": " Beuf", "s": 2.26, "e": 2.42}, {"w": " reviennent", "s": 2.42, "e": 2.78}, {"w": " enfin", "s": 2.78, "e": 3.12}, {"w": " à", "s": 3.12, "e": 3.3}, {"w": " Toulouse,", "s": 3.3, "e": 3.56}]}, {"start": 3.68, "end": 5.98, "text": " et ça se passe dans le meilleur resto chinois de la ville.", "words": [{"w": " et", "s": 3.68, "e": 3.74}, {"w": " ça", "s": 3.74, "e": 3.88}, {"w": " se", "s": 3.88, "e": 4.06}, {"w": " passe", "s": 4.06, "e": 4.22}, {"w": " dans", "s": 4.22, "e": 4.34}, {"w": " le", "s": 4.34, "e": 4.52}, {"w": " meilleur", "s": 4.52, "e": 4.7}, {"w": " resto", "s": 4.7, "e": 4.96}, {"w": " chinois", "s": 4.96, "e": 5.32}, {"w": " de", "s": 5.32, "e": 5.68}, {"w": " la", "s": 5.68, "e": 5.82}, {"w": " ville.", "s": 5.82, "e": 5.98}]}, {"start": 6.2, "end": 9.64, "text": " Ici, tout est excellent, notamment la préparation de la viande qui est incroyable.", "words": [{"w": " Ici,", "s": 6.2, "e": 6.38}, {"w": " tout", "s": 6.48, "e": 6.54}, {"w": " est", "s": 6.54, "e": 6.76}, {"w": " excellent,", "s": 6.76, "e": 7.1}, {"w": " notamment", "s": 7.32, "e": 7.54}, {"w": " la", "s": 7.54, "e": 7.74}, {"w": " préparation", "s": 7.74, "e": 8.2}, {"w": " de", "s": 8.2, "e": 8.34}, {"w": " la", "s": 8.34, "e": 8.5}, {"w": " viande", "s": 8.5, "e": 8.68}, {"w": " qui", "s": 8.68, "e": 8.94}, {"w": " est", "s": 8.94, "e": 9.08}, {"w": " incroyable.", "s": 9.08, "e": 9.64}]}, {"start": 9.78, "end": 13.12, "text": " Salut, moi c'est Harry, l'influencer en carton, e