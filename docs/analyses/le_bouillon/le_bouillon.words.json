[{"start": 0.0, "end": 1.34, "text": " Quelle note pour ce plat !", "words": [{"w": " Quelle", "s": 0.0, "e": 0.58}, {"w": " note", "s": 0.58, "e": 0.64}, {"w": " pour", "s": 0.64, "e": 0.84}, {"w": " ce", "s": 0.84, "e": 1.0}, {"w": " plat", "s": 1.0, "e": 1.14}, {"w": " !", "s": 1.14, "e": 1.34}]}, {"start": 1.34, "end": 4.22, "text": " Tout le monde parle du bouillon qui vient d'ouvrir sur la place du Capitole.", "words": [{"w": " Tout", "s": 1.34, "e": 1.42}, {"w": " le", "s": 1.42, "e": 1.54}, {"w": " monde", "s": 1.54, "e": 1.72}, {"w": " parle", "s": 1.72, "e": 1.96}, {"w": " du", "s": 1.96, "e": 2.1}, {"w": " bouillon", "s": 2.1, "e": 2.4}, {"w": " qui", "s": 2.4, "e": 2.58}, {"w": " vient", "s": 2.58, "e": 2.7}, {"w": " d", "s": 2.7, "e": 2.82}, {"w": "'ouvrir", "s": 2.82, "e": 3.08}, {"w": " sur", "s": 3.08, "e": 3.24}, {"w": " la", "s": 3.24, "e": 3.4}, {"w": " place", "s": 3.4, "e": 3.48}, {"w": " du", "s": 3.48, "e": 3.72}, {"w": " Capitole.", "s": 3.72, "e": 4.22}]}, {"start": 4.38, "end": 5.18, "text": " C'est parti pour le tester.", "words": [{"w": " C", "s": 4.38, "e": 4.4}, {"w": "'est", "s": 4.4, "e": 4.5}, {"w": " parti", "s": 4.5, "e": 4.68}, {"w": " pour", "s": 4.68, "e": 4.82}, {"w": " le", "s": 4.82, "e": 4.94}, {"w": " tester.", "s": 4.94, "e": 5.18}]}, {"start": 5.3, "end": 7.2, "text": " On est personne, mais on adore critiquer.", "words": [{"w": " On", "s": 5.3, "e": 5.38}, {"w": " est", "s": 5.38, "e": 5.56}, {"w": " personne,", "s": 5.56, "e": 6.02}, {"w": " mais", "s": 6.4, "e": 6.5}, {"w": " on", "s": 6.5, "e": 6.66}, {"w": " adore", "s": 6.66, "e": 6.78}, {"w": " critiquer.", "s": 6.78, "e": 7.2}]}, {"start": 7.34, "end": 10.38, "text": " On a attendu 6 mois avant d'y aller pour éviter la queue, mais c'est raté.", "words": [{"w": " On", "s": 7.34, "e": 7.5}, {"w": " a", "s": 7.5, "e": 7.64}, {"w": " attendu", "s": 7.64, "e": 7.96}, {"w": " 6", "s": 7.96, "e": 8.16}, {"w": " mois", "s": 8.16, "e": 8.36}, {"w": " avant", "s": 8.36, "e"