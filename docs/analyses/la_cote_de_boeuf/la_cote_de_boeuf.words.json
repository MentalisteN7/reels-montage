[{"start": 0.0, "end": 3.66, "text": " Si t'es fauché, mais que t'adore la bonne viande, j'ai trouvé le resto idéal pour toi.", "words": [{"w": " Si", "s": 0.0, "e": 0.18}, {"w": " t", "s": 0.18, "e": 0.3}, {"w": "'es", "s": 0.3, "e": 0.4}, {"w": " fauché,", "s": 0.4, "e": 0.82}, {"w": " mais", "s": 0.88, "e": 1.0}, {"w": " que", "s": 1.0, "e": 1.14}, {"w": " t", "s": 1.14, "e": 1.22}, {"w": "'adore", "s": 1.22, "e": 1.34}, {"w": " la", "s": 1.34, "e": 1.54}, {"w": " bonne", "s": 1.54, "e": 1.74}, {"w": " viande,", "s": 1.74, "e": 2.02}, {"w": " j", "s": 2.1, "e": 2.18}, {"w": "'ai", "s": 2.18, "e": 2.28}, {"w": " trouvé", "s": 2.28, "e": 2.42}, {"w": " le", "s": 2.42, "e": 2.56}, {"w": " resto", "s": 2.56, "e": 2.9}, {"w": " idéal", "s": 2.9, "e": 3.32}, {"w": " pour", "s": 3.32, "e": 3.48}, {"w": " toi.", "s": 3.48, "e": 3.66}]}, {"start": 3.74, "end": 6.72, "text": " Moi c'est Harry, l'influenceur en carton, et je découvre les pépites pour toi.", "words": [{"w": " Moi", "s": 3.74, "e": 3.94}, {"w": " c", "s": 3.94, "e": 4.18}, {"w": "'est", "s": 4.18, "e": 4.24}, {"w": " Harry,", "s": 4.24, "e": 4.4}, {"w": " l", "s": 4.52, "e": 4.68}, {"w": "'influenceur", "s": 4.68, "e": 4.94}, {"w": " en", "s": 4.94, "e": 5.08}, {"w": " carton,", "s": 5.08, "e": 5.28}, {"w": " et", "s": 5.36, "e": 5.42}, {"w": " je", "s": 5.42, "e": 5.62}, {"w": " découvre", "s": 5.62, "e": 5.9}, {"w": " les", "s": 5.9, "e": 6.06}, {"w": " pépites", "s": 6.06, "e": 6.38}, {"w": " pour", "s": 6.38, "e": 6.56}, {"w": " toi.", "s": 6.56, "e": 6.72}]}, {"start": 6.8, "end": 9.26, "text": " On se retrouve chez Côte de Boeuf, situé vers Capitole.", "words": [{"w": " On", "s": 6.8, "e": 6.92}, {"w": " se", "s": 6.92, "e": 7.08}, {"w": " retrouve", "s": 7.08, "e": 7.38}, {"w": " chez", "s": 7.38, "e": 7.6}, {"w": " Côte", "s": 7.6, "e": 7.88}, {"w": " de", "s": 7.88, "e": 8.06}, {"w": " Boeuf,", "s": 8.06, "e": 8.32}, {"w": " situé", "s": 8.44, "e": 8.62}, {"w": " vers", "s": 8.62, "e": 8.84}, {"w": " Capitole.", "s": 8.84, "e": 9.26}]}, {"start": 9.32, "end": 13.34, "text": " Nous sommes sur une déco authentique, avec un magnifique mur de brique et un accueil chaleureux.", "words": [{"w": " Nous", "s": 9.32, "e": 9.38}, {"w": " sommes", "s": 9.38, "e": 9.58}, {"w": " sur", "s": 9.58, "e": 9.74}, {"w": " une", "s": 9.74, "e": 9.86}, {"w": " déco", "s": 9.86, "e": 10.26}, {"w": " authentique,", "s": 10.26, "e": 10.86}, {"w": " avec", "s": 10.96, "e": 11.12}, {"w": " un", "s": 11.12, "e": 11.28}, {"w": " magnifique", "s": 11.28, "e": 11.7}, {"w": " mur", "s": 11.7, "e": 11.86}, {"w": " de", "s": 11.86, "e": 12.12}, {"w": " brique", "s": 12.12, "e": 12.26}, {"w": " et", "s": 12.26, "e": 12.44}, {"w": " un", "s": 12.44, "e": 12.64}, {"w": " accueil", "s": 12.64, "e": 12.98}, {"w": " chaleureux.", "s": 12.98, "e": 13.34}]}, {"start": 13.46, "end": 16.02, "text": " Ici tout est fait maison, et la gérante est vraiment adorable.", "words": [{"w": " Ici", "s": 13.46, "e": 13.78}, {"w": " tout", "s": 13.78, "e": 14.02}, {"w": " est", "s": 14.02, "e": 14.12}, {"w": " fait", "s": 14.12, "e": 14.22}, {"w": " maison,", "s": 14.22, "e": 14.44}, {"w": " et", "s": 14.52, "e": 14.62}, {"w": " la", "s": 14.62, "e": 14.78}, {"w": " gérante", "s": 14.78, "e": 15.12}, {"w": " est", "s": 15.12, "e": 15.28}, {"w": " vraiment", "s": 15.28, "e": 15.68}, {"w": " adorable.", "s": 15.68, "e": 16.02}]}, {"start": 16.1, "end": 20.06, "text": " Le menu complet est à seulement 19 euros, et on démarre avec Goose le bulldog pour l'entrée.", "words": [{"w": " Le", "s": 16.1, "e": 16.24}, {"w": " menu", "s": 16.24, "e": 16.42}, {"w": " complet", "s": 16.42, "e": 16.72}, {"w": " est", "s": 16.72, "e": 16.9}, {"w": " à", "s": 16.9, "e": 16.98}, {"w": " seulement", "s": 16.98, "e": 17.3}, {"w": " 19", "s": 17.3, "e": 17.68}, {"w": " euros,", "s": 17.68, "e": 17.92}, {"w": " et", "s": 17.96, "e": 18.06}, {"w": " on", "s": 18.06, "e": 18.18}, {"w": " démarre", "s": 18.18, "e": 18.46}, {"w": " avec", "s": 18.46, "e": 18.72}, {"w": " Goose", "s": 18.72, "e": 19.04}, {"w": " le", "s": 19.04, "e": 19.24}, {"w": " bulldog", "s": 19.24, "e": 19.6}, {"w": " pour", "s": 19.6, "e": 19.76}, {"w": " l", "s": 19.76, "e": 19.92}, {"w": "'entrée.", "s": 19.92, "e": 20.06}]}, {"start": 20.1, "end": 21.08, "text": " Qu'est-ce que tu as pris ?", "words": [{"w": " Qu", "s": 20.1, "e": 20.18}, {"w": "'est", "s": 20.18, "e": 20.26}, {"w": "-ce", "s": 20.26, "e": 20.26}, {"w": " que", "s": 20.26, "e": 20.34}, {"w": " tu", "s": 20.34, "e": 20.44}, {"w": " as", "s": 20.44, "e": 20.56}, {"w": " pris", "s": 20.56, "e": 20.72}, {"w": " ?", "s": 20.72, "e": 21.08}]}, {"start": 21.08, "end": 21.9, "text": " Des œufs limosa.", "words": [{"w": " Des", "s": 21.08, "e": 21.3}, {"w": " œufs", "s": 21.3, "e": 21.46}, {"w": " limosa.", "s": 21.46, "e": 21.9}]}, {"start": 22.06, "end": 23.1, "text": " Il y avait quoi dedans ?", "words": [{"w": " Il", "s": 22.06, "e": 22.14}, {"w": " y", "s": 22.14, "e": 22.16}, {"w": " avait", "s": 22.16, "e": 22.24}, {"w": " quoi", "s": 22.24, "e": 22.38}, {"w": " dedans", "s": 22.38, "e": 22.6}, {"w": " ?", "s": 22.6, "e": 23.1}]}, {"start": 23.1, "end": 26.12, "text": " Des œufs limosa, de la salade, et de la maillou.", "words": [{"w": " Des", "s": 23.1, "e": 23.26}, {"w": " œufs", "s": 23.26, "e": 23.64}, {"w": " limosa,", "s": 23.64, "e": 24.04}, {"w": " de", "s": 24.18, "e": 24.3}, {"w": " la", "s": 24.3, "e": 24.54}, {"w": " salade,", "s": 24.54, "e": 24.98}, {"w": " et", "s": 25.32, "e": 25.46}, {"w": " de", "s": 25.46, "e": 25.58}, {"w": " la", "s": 25.58, "e": 25.72}, {"w": " maillou.", "s": 25.72, "e": 26.12}]}, {"start": 27.14, "end": 28.240000000000002, "text": " Quel note pour ce plat ?", "words": [{"w": " Quel", "s": 27.14, "e": 27.46}, {"w": " note", "s": 27.46, "e": 27.58}, {"w": " pour", "s": 27.58, "e": 27.76}, {"w": " ce", "s": 27.76, "e": 27.94}, {"w": " plat", "s": 27.94, "e": 28.1}, {"w": " ?", "s": 28.1, "e": 28.26}]}, {"start": 29.86, "end": 30.8, "text": " Neuf, pour les œufs.", "words": [{"w": " Neuf,", "s": 29.86, "e": 30.22}, {"w": " pour", "s": 30.28, "e": 30.46}, {"w": " les", "s": 30.46, "e": 30.62}, {"w": " œufs.", "s": 30.62, "e": 30.8}]}, {"start": 30.92, "end": 31.88, "text": " Merci pour cette blague.", "words": [{"w": " Merci", "s": 30.92, "e": 31.18}, {"w": " pour", "s": 31.18, "e": 31.5}, {"w": " cette", "s": 31.5, "e": 31.66}, {"w": " blague.", "s": 31.66, "e": 31.88}]}, {"start": 32.0, "end": 33.68, "text": " La mayonnaise était juste incroyable.", "words": [{"w": " La", "s": 32.0, "e": 32.14}, {"w": " mayonnaise", "s": 32.14, "e": 32.5}, {"w": " était", "s": 32.5, "e": 32.82}, {"w": " juste", "s": 32.82, "e": 33.18}, {"w": " incroyable.", "s": 33.18, "e": 33.68}]}, {"start": 33.8, "end": 37.56, "text": " On enchaîne avec le plat, et on accueille pour la première fois Erwan le rugbyman.", "words": [{"w": " On", "s": 33.8, "e": 33.96}, {"w": " enchaîne", "s": 33.96, "e": 34.2}, {"w": " avec", "s": 34.2, "e": 34.4}, {"w": " le", "s": 34.4, "e": 34.68}, {"w": " plat,", "s": 34.68, "e": 34.78}, {"w": " et", "s": 34.92, "e": 34.98}, {"w": " on", "s": 34.98, "e": 35.14}, {"w": " accueille", "s": 35.14, "e": 35.36}, {"w": " pour", "s": 35.36, "e": 35.52}, {"w": " la", "s": 35.52, "e": 35.8}, {"w": " première", "s": 35.8, "e": 36.02}, {"w": " fois", "s": 36.02, "e": 36.28}, {"w": " Erwan", "s": 36.28, "e": 36.72}, {"w": " le", "s": 36.72, "e": 37.04}, {"w": " rugbyman.", "s": 37.04, "e": 37.56}]}, {"start": 37.74, "end": 41.78, "text": " Alors j'ai pris la formule complète entre le plat dessert, avec la brochette de Magret,", "words": [{"w": " Alors", "s": 37.74, "e": 37.9}, {"w": " j", "s": 37.9, "e": 38.12}, {"w": "'ai", "s": 38.12, "e": 38.28}, {"w": " pris", "s": 38.28, "e": 38.56}, {"w": " la", "s": 38.56, "e": 38.72}, {"w": " formule", "s": 38.72, "e": 38.94}, {"w": " complète", "s": 38.94, "e": 39.42}, {"w": " entre", "s": 39.42, "e": 39.7}, {"w": " le", "s": 39.7, "e": 39.74}, {"w": " plat", "s": 39.74, "e": 39.84}, {"w": " dessert,", "s": 39.84, "e": 40.14}, {"w": " avec", "s": 40.4, "e": 40.54}, {"w": " la", "s": 40.54, "e": 41.02}, {"w": " brochette", "s": 41.02, "e": 41.26}, {"w": " de", "s": 41.26, "e": 41.5}, {"w": " Magret,", "s": 41.5, "e": 41.78}]}, {"start": 41.98, "end": 43.62, "text": " sa salade et ses bonnes grosses frites.", "words": [{"w": " sa", "s": 41.98, "e": 42.14}, {"w": " salade", "s": 42.14, "e": 42.46}, {"w": " et", "s": 42.46, "e": 42.6}, {"w": " ses", "s": 42.6, "e": 42.74}, {"w": " bonnes", "s": 42.74, "e": 43.0}, {"w": " grosses", "s": 43.0, "e": 43.26}, {"w": " frites.", "s": 43.26, "e": 43.62}]}, {"start": 44.3, "end": 47.16, "text": " Alors moi je vais mettre une solide neuf, parce que le plat était très bon,", "words": [{"w": " Alors", "s": 44.3, "e": 44.42}, {"w": " moi", "s": 44.42, "e": 44.58}, {"w": " je", "s": 44.58, "e": 44.68}, {"w": " vais", "s": 44.68, "e": 44.7}, {"w": " mettre", "s": 44.7, "e": 44.92}, {"w": " une", "s": 44.92, "e": 45.32}, {"w": " solide", "s": 45.32, "e": 45.64}, {"w": " neuf,", "s": 45.64, "e": 45.88}, {"w": " parce", "s": 45.96, "e": 46.16}, {"w": " que", "s": 46.16, "e": 46.36}, {"w": " le", "s": 46.36, "e": 46.54}, {"w": " plat", "s": 46.54, "e": 46.58}, {"w": " était", "s": 46.58, "e": 46.76}, {"w": " très", "s": 46.76, "e": 47.06}, {"w": " bon,", "s": 47.06, "e": 47.16}]}, {"start": 47.28, "end": 48.18, "text": " ça se voyait que c'était fait maison.", "words": [{"w": " ça", "s": 47.28, "e": 47.38}, {"w": " se", "s": 47.38, "e": 47.46}, {"w": " voyait", "s": 47.46, "e": 47.54}, {"w": " que", "s": 47.54, "e": 47.62}, {"w": " c", "s": 47.62, "e": 47.74}, {"w": "'était", "s": 47.74, "e": 47.78}, {"w": " fait", "s": 47.78, "e": 47.98}, {"w": " maison.", "s": 47.98, "e": 48.18}]}, {"start": 48.3, "end": 49.76, "text": " C'est vraiment très très bon, c'est exceptionnel.", "words": [{"w": " C", "s": 48.3, "e": 48.36}, {"w": "'est", "s": 48.36, "e": 48.36}, {"w": " vraiment", "s": 48.36, "e": 48.54}, {"w": " très", "s": 48.54, "e": 48.84}, {"w": " très", "s": 48.84, "e": 48.96}, {"w": " bon,", "s": 48.96, "e": 49.06}, {"w": " c", "s": 49.16, "e": 49.32}, {"w": "'est", "s": 49.32, "e": 49.32}, {"w": " exceptionnel.", "s": 49.32, "e": 49.76}]}, {"start": 49.84, "end": 53.6, "text": " Et mention spéciale à la déco et à la serveuse qui était toute seule, mais qui gérait très très bien.", "words": [{"w": " Et", "s": 49.84, "e": 49.96}, {"w": " mention", "s": 49.96, "e": 50.1}, {"w": " spéciale", "s": 50.1, "e": 50.6}, {"w": " à", "s": 50.6, "e": 50.7}, {"w": " la", "s": 50.7, "e": 50.86}, {"w": " déco", "s": 50.86, "e": 51.1}, {"w": " et", "s": 51.1, "e": 51.2}, {"w": " à", "s": 51.2, "e": 51.28}, {"w": " la", "s": 51.28, "e": 51.44}, {"w": " serveuse", "s": 51.44, "e": 51.68}, {"w": " qui", "s": 51.68, "e": 51.82}, {"w": " était", "s": 51.82, "e": 52.22}, {"w": " toute", "s": 52.22, "e": 52.46}, {"w": " seule,", "s": 52.46, "e": 52.54}, {"w": " mais", "s": 52.58, "e": 52.76}, {"w": " qui", "s": 52.76, "e": 52.9}, {"w": " gérait", "s": 52.9, "e": 53.12}, {"w": " très", "s": 53.12, "e": 53.36}, {"w": " très", "s": 53.36, "e": 53.52}, {"w": " bien.", "s": 53.52, "e": 53.6}]}, {"start": 53.7, "end": 55.6, "text": " Si vous aimez ce personnage, je le réinviterai.", "words": [{"w": " Si", "s": 53.7, "e": 53.72}, {"w": " vous", "s": 53.72, "e": 53.92}, {"w": " aimez", "s": 53.92, "e": 54.14}, {"w": " ce", "s": 54.14, "e": 54.24}, {"w": " personnage,", "s": 54.24, "e": 54.66}, {"w": " je", "s": 54.8, "e": 54.86}, {"w": " le", "s": 54.86, "e": 55.2}, {"w": " réinviterai.", "s": 55.2, "e": 55.6}]}, {"start": 55.64, "end": 57.42, "text": " En attendant, Goose aimerait rajouter quelque chose.", "words": [{"w": " En", "s": 55.64, "e": 55.84}, {"w": " attendant,", "s": 55.84, "e": 56.16}, {"w": " Goose", "s": 56.32, "e": 56.4}, {"w": " aimerait", "s": 56.4, "e": 56.7}, {"w": " rajouter", "s": 56.7, "e": 56.98}, {"w": " quelque", "s": 56.98, "e": 57.26}, {"w": " chose.", "s": 57.26, "e": 57.42}]}, {"start": 57.42, "end": 59.92, "text": " Je pense que dans les commentaires, il devrait y avoir un petit débat sur", "words": [{"w": " Je", "s": 57.42, "e": 57.52}, {"w": " pense", "s": 57.52, "e": 57.7}, {"w": " que", "s": 57.7, "e": 57.88}, {"w": " dans", "s": 57.88, "e": 57.94}, {"w": " les", "s": 57.94, "e": 58.14}, {"w": " commentaires,", "s": 58.14, "e": 58.44}, {"w": " il", "s": 58.6, "e": 58.6}, {"w": " devrait", "s": 58.6, "e": 58.78}, {"w": " y", "s": 58.78, "e": 58.84}, {"w": " avoir", "s": 58.84, "e": 59.04}, {"w": " un", "s": 59.04, "e": 59.16}, {"w": " petit", "s": 59.16, "e": 59.34}, {"w": " débat", "s": 59.34, "e": 59.7}, {"w": " sur", "s": 59.7, "e": 59.92}]}, {"start": 59.92, "end": 63.3, "text": " est-ce que vous préférez voir Marie ou moi, parce qu'elle est un peu trop souvent à la caméra.", "words": [{"w": " est", "s": 59.92, "e": 60.0}, {"w": "-ce", "s": 60.0, "e": 60.16}, {"w": " que", "s": 60.16, "e": 60.18}, {"w": " vous", "s": 60.18, "e": 60.32}, {"w": " préférez", "s": 60.32, "e": 60.66}, {"w": " voir", "s": 60.66, "e": 60.86}, {"w": " Marie", "s": 60.86, "e": 61.16}, {"w": " ou", "s": 61.16, "e": 61.36}, {"w": " moi,", "s": 61.36, "e": 61.44}, {"w": " parce", "s": 61.62, "e": 61.7}, {"w": " qu", "s": 61.7, "e": 61.98}, {"w": "'elle", "s": 61.98, "e": 62.1}, {"w": " est", "s": 62.1, "e": 62.22}, {"w": " un", "s": 62.22, "e": 62.3}, {"w": " peu", "s": 62.3, "e": 62.52}, {"w": " trop", "s": 62.52, "e": 62.76}, {"w": " souvent", "s": 62.76, "e": 62.96}, {"w": " à", "s": 62.96, "e": 63.06}, {"w": " la", "s": 63.06, "e": 63.2}, {"w": " caméra.", "s": 63.2, "e": 63.3}]}]