[{"start": 0.0, "end": 4.72, "text": " Si t'es fauché et que tu veux manger une bonne pizza à 5€, j'ai trouvé la pizzeria idéale pour toi.", "words": [{"w": " Si", "s": 0.0, "e": 0.16}, {"w": " t", "s": 0.16, "e": 0.32}, {"w": "'es", "s": 0.32, "e": 0.38}, {"w": " fauché", "s": 0.38, "e": 0.7}, {"w": " et", "s": 0.7, "e": 0.82}, {"w": " que", "s": 0.82, "e": 0.96}, {"w": " tu", "s": 0.96, "e": 1.06}, {"w": " veux", "s": 1.06, "e": 1.14}, {"w": " manger", "s": 1.14, "e": 1.4}, {"w": " une", "s": 1.4, "e": 1.58}, {"w": " bonne", "s": 1.58, "e": 1.76}, {"w": " pizza", "s": 1.76, "e": 2.06}, {"w": " à", "s": 2.06, "e": 2.38}, {"w": " 5€,", "s": 2.38, "e": 2.78}, {"w": " j", "s": 2.86, "e": 2.92}, {"w": "'ai", "s": 2.92, "e": 3.0}, {"w": " trouvé", "s": 3.0, "e": 3.18}, {"w": " la", "s": 3.18, "e": 3.42}, {"w": " pizzeria", "s": 3.42, "e": 3.94}, {"w": " idéale", "s": 3.94, "e": 4.4}, {"w": " pour", "s": 4.4, "e": 4.58}, {"w": " toi.", "s": 4.58, "e": 4.72}]}, {"start": 4.78, "end": 8.68, "text": " Moi c'est Harry l'influencer en carton et je te déniche les pépites pas chères à Toulouse.", "words": [{"w": " Moi", "s": 4.78, "e": 4.94}, {"w": " c", "s": 4.94, "e": 5.14}, {"w": "'est", "s": 5.14, "e": 5.34}, {"w": " Harry", "s": 5.34, "e": 5.54}, {"w": " l", "s": 5.54, "e": 5.72}, {"w": "'influencer", "s": 5.72, "e": 6.04}, {"w": " en", "s": 6.04, "e": 6.22}, {"w": " carton", "s": 6.22, "e": 6.48}, {"w": " et", "s": 6.48, "e": 6.6}, {"w": " je", "s": 6.6, "e": 6.72}, {"w": " te", "s": 6.72, "e": 6.84}, {"w": " déniche", "s": 6.84, "e": 7.12}, {"w": " les", "s": 7.12, "e": 7.3}, {"w": " pépites", "s": 7.3, "e": 7.62}, {"w": " pas", "s": 7.62, "e": 7.9}, {"w": " chères", "s": 7.9, "e": 8.16}, {"w": " à", "s": 8.16, "e": 8.4}, {"w": " Toulouse.", "s": 8.4, "e": 8.68}]}, {"start": 8.78, "end": 11.4, "text": " On se retrouve chez les deux potes à deux pas du Capitole.", "words": [{"w": " On", "s": 8.78, "e": 8.84}, {"w": " se", "s": 8.84, "e": 9.04}, {"w": " retrouve", "s": 9.04, "e": 9.28}, {"w": " chez", "s": 9.28, "e": 9.44}, {"w": " les", "s": 9.44, "e": 9.66}, {"w": " deux", "s": 9.66, "e": 9.84}, {"w": " potes", "s": 9.84, "e": 10.14}, {"w": " à", "s": 10.14, "e": 10.4}, {"w": " deux", "s": 10.4, "e": 10.54}, {"w": " pas", "s": 10.54, "e": 10.68}, {"w": " du", "s": 10.68, "e": 10.9}, {"w": " Capitole.", "s": 10.9, "e": 11.4}]}, {"start": 11.6, "end": 17.26, "text": " Ici l'idéal est de prendre à emporter et d'aller se poser sur les quais de la Garonne à 5 minutes à pied ou simplement dans son appart.", "words": [{"w": " Ici", "s": 11.6, "e": 11.78}, {"w": " l", "s": 11.78, "e": 11.98}, {"w": "'idéal", "s": 11.98, "e": 12.24}, {"w": " est", "s": 12.24, "e": 12.34}, {"w": " de", "s": 12.34, "e": 12.5}, {"w": " prendre", "s": 12.5, "e": 12.64}, {"w": " à", "s": 12.64, "e": 12.82}, {"w": " emporter", "s": 12.82, "e": 13.18}, {"w": " et", "s": 13.18, "e": 13.34}, {"w": " d", "s": 13.34, "e": 13.42}, {"w": "'aller", "s": 13.42, "e": 13.52}, {"w": " se", "s": 13.52, "e": 13.76}, {"w": " poser", "s": 13.76, "e": 13.92}, {"w": " sur", "s": 13.92, "e": 14.08}, {"w": " les", "s": 14.08, "e": 14.26}, {"w": " quais", "s": 14.26, "e": 14.34}, {"w": " de", "s": 14.34, "e": 14.5}, {"w": " la", "s": 14.5, "e": 14.66}, {"w": " Garonne", "s": 14.66, "e": 14.9}, {"w": " à", "s": 14.9, "e": 15.1}, {"w": " 5", "s": 15.1, "e": 15.24}, {"w": " minutes", "s": 15.24, "e": 15.54}, {"w": " à", "s": 15.54, "e": 15.8}, {"w": " pied", "s": 15.8, "e": 15.88}, {"w": " ou", "s": 15.88, "e": 16.08}, {"w": " simplement", "s": 16.08, "e": 16.56}, {"w": " dans", "s": 16.56, "e": 16.74}, {"w": " son", "s": 16.74, "e": 16.94}, {"w": " appart.", "s": 16.94, "e": 17.26}]}, {"start": 17.32, "end": 19.06, "text": " A 5€ la pizza, tout est possible.", "words": [{"w": " A", "s": 17.32, "e": 17.48}, {"w": " 5€", "s": 17.48, "e": 17.92}, {"w": " la", "s": 17.92, "e": 18.08}, {"w": " pizza,", "s": 18.08, "e": 18.36}, {"w": " tout", "s": 18.46, "e": 18.54}, {"w": " est", "s": 18.54, "e": 18.7}, {"w": " possible.", "s": 18.7, "e": 19.06}]}, {"start": 19.12, "end": 22.82, "text": " Pour ce nouvel épisode, j'ai invité des abonnés à manger avec moi et à donner leurs avis.", "words": [{"w": " Pour", "s": 19.12, "e": 19.26}, {"w": " ce", "s": 19.26, "e": 19.44}, {"w": " nouvel", "s": 19.44, "e": 19.66}, {"w": " épisode,", "s": 19.66, "e": 20.08}, {"w": " j", "s": 20.18, "e": 20.28}, {"w": "'ai", "s": 20.28, "e": 20.42}, {"w": " invité", "s": 20.42, "e": 20.58}, {"w": " des", "s": 20.58, "e": 20.78}, {"w": " abonnés", "s": 20.78, "e": 21.06}, {"w": " à", "s": 21.06, "e": 21.18}, {"w": " manger", "s": 21.18, "e": 21.38}, {"w": " avec", "s": 21.38, "e": 21.66}, {"w": " moi", "s": 21.66, "e": 21.88}, {"w": " et", "s": 21.88, "e": 22.06}, {"w": " à", "s": 22.06, "e": 22.18}, {"w": " donner", "s": 22.18, "e": 22.38}, {"w": " leurs", "s": 22.38, "e": 22.66}, {"w": " avis.", "s": 22.66, "e": 22.82}]}, {"start": 22.86, "end": 24.98, "text": " On démarre avec Thomas qui a fait l'amour dans le pré.", "words": [{"w": " On", "s": 22.86, "e": 23.0}, {"w": " démarre", "s": 23.0, "e": 23.3}, {"w": " avec", "s": 23.3, "e": 23.52}, {"w": " Thomas", "s": 23.52, "e": 23.82}, {"w": " qui", "s": 23.82, "e": 23.96}, {"w": " a", "s": 23.96, "e": 24.06}, {"w": " fait", "s": 24.06, "e": 24.16}, {"w": " l", "s": 24.16, "e": 24.3}, {"w": "'amour", "s": 24.3, "e": 24.52}, {"w": " dans", "s": 24.52, "e": 24.72}, {"w": " le", "s": 24.72, "e": 24.92}, {"w": " pré.", "s": 24.92, "e": 24.98}]}, {"start": 25.04, "end": 25.74, "text": " J'ai pris une Galzone.", "words": [{"w": " J", "s": 25.04, "e": 25.08}, {"w": "'ai", "s": 25.08, "e": 25.2}, {"w": " pris", "s": 25.2, "e": 25.3}, {"w": " une", "s": 25.3, "e": 25.42}, {"w": " Galzone.", "s": 25.42, "e": 25.74}]}, {"start": 25.82, "end": 28.9, "text": " Y'avait du fromage, y'avait du jambon et y'avait...", "words": [{"w": " Y", "s": 25.82, "e": 25.86}, {"w": "'avait", "s": 25.86, "e": 25.94}, {"w": " du", "s": 25.94, "e": 26.16}, {"w": " fromage,", "s": 26.16, "e": 26.68}, {"w": " y", "s": 26.76, "e": 26.76}, {"w": "'avait", "s": 26.76, "e": 26.96}, {"w": " du", "s": 26.96, "e": 27.2}, {"w": " jambon", "s": 27.2, "e": 27.7}, {"w": " et", "s": 27.7, "e": 28.24}, {"w": " y", "s": 28.24, "e": 28.36}, {"w": "'avait...", "s": 28.36, "e": 28.9}]}, {"start": 28.9, "end": 29.56, "text": " C'est tout je crois.", "words": [{"w": " C", "s": 28.9, "e": 29.02}, {"w": "'est", "s": 29.02, "e": 29.06}, {"w": " tout", "s": 29.06, "e": 29.24}, {"w": " je", "s": 29.24, "e": 29.44}, {"w": " crois.", "s": 29.44, "e": 29.56}]}, {"start": 29.56, "end": 30.3, "text": " Mozart est là.", "words": [{"w": " Mozart", "s": 29.56, "e": 30.1}, {"w": " est", "s": 30.1, "e": 30.24}, {"w": " là.", "s": 30.24, "e": 30.3}]}, {"start": 30.34, "end": 31.62, "text": " Du coup je vais mettre la note de 7.", "words": [{"w": " Du", "s": 30.34, "e": 30.46}, {"w": " coup", "s": 30.46, "e": 30.54}, {"w": " je", "s": 30.54, "e": 30.64}, {"w": " vais", "s": 30.64, "e": 30.7}, {"w": " mettre", "s": 30.7, "e": 30.84}, {"w": " la", "s": 30.84, "e": 30.98}, {"w": " note", "s": 30.98, "e": 31.06}, {"w": " de", "s": 31.06, "e": 31.44}, {"w": " 7.", "s": 31.44, "e": 31.62}]}, {"start": 31.74, "end": 32.54, "text": " Je trouve qu'elle était bonne.", "words": [{"w": " Je", "s": 31.74, "e": 31.8}, {"w": " trouve", "s": 31.8, "e": 31.9}, {"w": " qu", "s": 31.9, "e": 32.0}, {"w": "'elle", "s": 32.0, "e": 32.1}, {"w": " était", "s": 32.1, "e": 32.26}, {"w": " bonne.", "s": 32.26, "e": 32.54}]}, {"start": 32.86, "end": 35.02, "text": " Le fromage était bon, il était bien fondant, elle était bien garnie,", "words": [{"w": " Le", "s": 32.86, "e": 32.98}, {"w": " fromage", "s": 32.98, "e": 33.24}, {"w": " était", "s": 33.24, "e": 33.38}, {"w": " bon,", "s": 33.38, "e": 33.56}, {"w": " il", "s": 33.58, "e": 33.66}, {"w": " était", "s": 33.66, "e": 33.8}, {"w": " bien", "s": 33.8, "e": 33.98}, {"w": " fondant,", "s": 33.98, "e": 34.24}, {"w": " elle", "s": 34.3, "e": 34.36}, {"w": " était", "s": 34.36, "e": 34.5}, {"w": " bien", "s": 34.5, "e": 34.7}, {"w": " garnie,", "s": 34.7, "e": 35.02}]}, {"start": 35.06, "end": 38.62, "text": " mais il manquait juste un petit peu d'épices pour avoir une meilleure note que ça.", "words": [{"w": " mais", "s": 35.06, "e": 35.34}, {"w": " il", "s": 35.34, "e": 35.46}, {"w": " manquait", "s": 35.46, "e": 35.7}, {"w": " juste", "s": 35.7, "e": 35.9}, {"w": " un", "s": 35.9, "e": 35.98}, {"w": " petit", "s": 35.98, "e": 36.14}, {"w": " peu", "s": 36.14, "e": 36.26}, {"w": " d", "s": 36.26, "e": 36.38}, {"w": "'épices", "s": 36.38, "e": 36.66}, {"w": " pour", "s": 36.66, "e": 37.16}, {"w": " avoir", "s": 37.16, "e": 37.66}, {"w": " une", "s": 37.66, "e": 37.92}, {"w": " meilleure", "s": 37.92, "e": 38.2}, {"w": " note", "s": 38.2, "e": 38.3}, {"w": " que", "s": 38.3, "e": 38.46}, {"w": " ça.", "s": 38.46, "e": 38.62}]}, {"start": 39.1, "end": 39.94, "text": " Mais bon rapport qualité prix.", "words": [{"w": " Mais", "s": 39.1, "e": 39.18}, {"w": " bon", "s": 39.18, "e": 39.28}, {"w": " rapport", "s": 39.28, "e": 39.56}, {"w": " qualité", "s": 39.56, "e": 39.78}, {"w": " prix.", "s": 39.78, "e": 39.94}]}, {"start": 40.06, "end": 42.12, "text": " On enchaîne avec Johan, qu'on surnomme Choupie Beer.", "words": [{"w": " On", "s": 40.06, "e": 40.16}, {"w": " enchaîne", "s": 40.16, "e": 40.46}, {"w": " avec", "s": 40.46, "e": 40.7}, {"w": " Johan,", "s": 40.7, "e": 41.06}, {"w": " qu", "s": 41.12, "e": 41.28}, {"w": "'on", "s": 41.28, "e": 41.28}, {"w": " surnomme", "s": 41.28, "e": 41.6}, {"w": " Choupie", "s": 41.6, "e": 41.98}, {"w": " Beer.", "s": 41.98, "e": 42.12}]}, {"start": 42.2, "end": 43.82, "text": " J'ai pris une pizza 4 fromages.", "words": [{"w": " J", "s": 42.2, "e": 42.3}, {"w": "'ai", "s": 42.3, "e": 42.4}, {"w": " pris", "s": 42.4, "e": 42.54}, {"w": " une", "s": 42.54, "e": 42.76}, {"w": " pizza", "s": 42.76, "e": 43.04}, {"w": " 4", "s": 43.04, "e": 43.34}, {"w": " fromages.", "s": 43.34, "e": 43.82}]}, {"start": 43.86, "end": 44.98, "text": " Je mets la note de 6.", "words": [{"w": " Je", "s": 43.86, "e": 44.0}, {"w": " mets", "s": 44.0, "e": 44.08}, {"w": " la", "s": 44.08, "e": 44.22}, {"w": " note", "s": 44.22, "e": 44.32}, {"w": " de", "s": 44.32, "e": 44.58}, {"w": " 6.", "s": 44.58, "e": 44.98}]}, {"start": 45.22, "end": 48.66, "text": " Alors 6 parce que bon, la pâte était plutôt bonne, plutôt aérée,", "words": [{"w": " Alors", "s": 45.22, "e": 45.4}, {"w": " 6", "s": 45.4, "e": 45.62}, {"w": " parce", "s": 45.62, "e": 45.86}, {"w": " que", "s": 45.86, "e": 46.04}, {"w": " bon,", "s": 46.04, "e": 46.24}, {"w": " la", "s": 46.3, "e": 46.44}, {"w": " pâte", "s": 46.44, "e": 46.6}, {"w": " était", "s": 46.6, "e": 47.02}, {"w": " plutôt", "s": 47.02, "e": 47.34}, {"w": " bonne,", "s": 47.34, "e": 47.64}, {"w": " plutôt", "s": 47.86, "e": 48.04}, {"w": " aérée,", "s": 48.04, "e": 48.66}]}, {"start": 48.78, "end": 52.7, "text": " mais par contre la pizza était un peu limitée en ingrédients.", "words": [{"w": " mais", "s": 48.78, "e": 48.96}, {"w": " par", "s": 48.96, "e": 49.22}, {"w": " contre", "s": 49.22, "e": 49.4}, {"w": " la", "s": 49.4, "e": 49.66}, {"w": " pizza", "s": 49.66, "e": 49.88}, {"w": " était", "s": 49.88, "e": 50.1}, {"w": " un", "s": 50.1, "e": 50.46}, {"w": " peu", "s": 50.46, "e": 51.18}, {"w": " limitée", "s": 51.18, "e": 51.86}, {"w": " en", "s": 51.86, "e": 52.22}, {"w": " ingrédients.", "s": 52.22, "e": 52.7}]}, {"start": 52.96, "end": 55.36, "text": " Emmental, Gorgonzola, Roquefort, Mozart.", "words": [{"w": " Emmental,", "s": 52.96, "e": 53.32}, {"w": " Gorgonzola,", "s": 53.6, "e": 54.26}, {"w": " Roquefort,", "s": 54.56, "e": 54.96}, {"w": " Mozart.", "s": 55.1, "e": 55.36}]}, {"start": 55.42, "end": 58.5, "text": " Donc ça manquait un peu de fromages pour une 4 fromages, un peu de fromages différents.", "words": [{"w": " Donc", "s": 55.42, "e": 55.54}, {"w": " ça", "s": 55.54, "e": 55.68}, {"w": " manquait", "s": 55.68, "e": 56.06}, {"w": " un", "s": 56.06, "e": 56.18}, {"w": " peu", "s": 56.18, "e": 56.26}, {"w": " de", "s": 56.26, "e": 56.46}, {"w": " fromages", "s": 56.46, "e": 56.74}, {"w": " pour", "s": 56.74, "e": 56.92}, {"w": " une", "s": 56.92, "e": 57.08}, {"w": " 4", "s": 57.08, "e": 57.26}, {"w": " fromages,", "s": 57.26, "e": 57.68}, {"w": " un", "s": 57.78, "e": 57.88}, {"w": " peu", "s": 57.88, "e": 57.98}, {"w": " de", "s": 57.98, "e": 58.1}, {"w": " fromages", "s": 58.1, "e": 58.26}, {"w": " différents.", "s": 58.26, "e": 58.5}]}, {"start": 58.5, "end": 60.58, "text": " Enfin, Hugo et Régis pour clôturer la review.", "words": [{"w": " Enfin,", "s": 58.5, "e": 58.92}, {"w": " Hugo", "s": 59.06, "e": 59.2}, {"w": " et", "s": 59.2, "e": 59.34}, {"w": " Régis", "s": 59.34, "e": 59.56}, {"w": " pour", "s": 59.56, "e": 59.7}, {"w": " clôturer", "s": 59.7, "e": 60.14}, {"w": " la", "s": 60.14, "e": 60.34}, {"w": " review.", "s": 60.34, "e": 60.58}]}, {"start": 60.62, "end": 61.08, "text": " 4 saisons.", "words": [{"w": " 4", "s": 60.62, "e": 60.74}, {"w": " saisons.", "s": 60.74, "e": 61.08}]}, {"start": 61.18, "end": 62.16, "text": " Une grande pour moi, évidemment.", "words": [{"w": " Une", "s": 61.18, "e": 61.26}, {"w": " grande", "s": 61.26, "e": 61.46}, {"w": " pour", "s": 61.46, "e": 61.68}, {"w": " moi,", "s": 61.68, "e": 61.9}, {"w": " évidemment.", "s": 62.0, "e": 62.16}]}, {"start": 62.48, "end": 63.12, "text": " Et pour moi une petite.", "words": [{"w": " Et", "s": 62.48, "e": 62.58}, {"w": " pour", "s": 62.58, "e": 62.62}, {"w": " moi", "s": 62.62, "e": 62.72}, {"w": " une", "s": 62.72, "e": 62.84}, {"w": " petite.", "s": 62.84, "e": 63.12}]}, {"start": 63.64, "end": 63.96, "text": " Jambon.", "words": [{"w": " Jambon.", "s": 63.64, "e": 63.96}]}, {"start": 64.26, "end": 64.58, "text": " Champignon.", "words": [{"w": " Champignon.", "s": 64.26, "e": 64.58}]}, {"start": 65.0, "end": 66.24, "text": " Champignon et moissons aux lignes.", "words": [{"w": " Champignon", "s": 65.0, "e": 65.32}, {"w": " et", "s": 65.32, "e": 65.54}, {"w": " moissons", "s": 65.54, "e": 65.8}, {"w": " aux", "s": 65.8, "e": 65.94}, {"w": " lignes.", "s": 65.94, "e": 66.24}]}, {"start": 66.68, "end": 67.0, "text": " T17.", "words": [{"w": " T17.", "s": 66.68, "e": 67.0}]}, {"start": 67.7, "end": 68.48, "text": " Franchement, elle est bonne.", "words": [{"w": " Franchement,", "s": 67.7, "e": 68.02}, {"w": " elle", "s": 68.1, "e": 68.2}, {"w": " est", "s": 68.2, "e": 68.32}, {"w": " bonne.", "s": 68.32, "e": 68.48}]}, {"start": 68.82, "end": 69.8, "text": " C'est un bon rapport qualité prix.", "words": [{"w": " C", "s": 68.82, "e": 68.82}, {"w": "'est", "s": 68.82, "e": 68.9}, {"w": " un", "s": 68.9, "e": 69.0}, {"w": " bon", "s": 69.0, "e": 69.06}, {"w": " rapport", "s": 69.06, "e": 69.26}, {"w": " qualité", "s": 69.26, "e": 69.5}, {"w": " prix.", "s": 69.5, "e": 69.8}]}, {"start": 69.92, "end": 70.76, "text": " La pâte est sympa.", "words": [{"w": " La", "s": 69.92, "e": 70.08}, {"w": " pâte", "s": 70.08, "e": 70.22}, {"w": " est", "s": 70.22, "e": 70.36}, {"w": " sympa.", "s": 70.36, "e": 70.76}]}, {"start": 70.86, "end": 71.76, "text": " Ouais, la pâte est hyper bonne.", "words": [{"w": " Ouais,", "s": 70.86, "e": 70.96}, {"w": " la", "s": 71.1, "e": 71.1}, {"w": " pâte", "s": 71.1, "e": 71.26}, {"w": " est", "s": 71.26, "e": 71.52}, {"w": " hyper", "s": 71.52, "e": 71.6}, {"w": " bonne.", "s": 71.6, "e": 71.76}]}]