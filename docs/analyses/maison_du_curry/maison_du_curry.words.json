[{"start": 0.0, "end": 2.56, "text": " POV, tu juges les restos avec les copains.", "words": [{"w": " POV,", "s": 0.0, "e": 0.72}, {"w": " tu", "s": 0.9, "e": 1.06}, {"w": " juges", "s": 1.06, "e": 1.3}, {"w": " les", "s": 1.3, "e": 1.46}, {"w": " restos", "s": 1.46, "e": 1.84}, {"w": " avec", "s": 1.84, "e": 2.08}, {"w": " les", "s": 2.08, "e": 2.3}, {"w": " copains.", "s": 2.3, "e": 2.56}]}, {"start": 2.66, "end": 5.34, "text": " À Toulouse, on vous a peut-être trouvé le meilleur restaurant indien.", "words": [{"w": " À", "s": 2.66, "e": 2.8}, {"w": " Toulouse,", "s": 2.8, "e": 3.22}, {"w": " on", "s": 3.32, "e": 3.44}, {"w": " vous", "s": 3.44, "e": 3.56}, {"w": " a", "s": 3.56, "e": 3.68}, {"w": " peut", "s": 3.68, "e": 3.82}, {"w": "-être", "s": 3.82, "e": 3.94}, {"w": " trouvé", "s": 3.94, "e": 4.16}, {"w": " le", "s": 4.16, "e": 4.44}, {"w": " meilleur", "s": 4.44, "e": 4.68}, {"w": " restaurant", "s": 4.68, "e": 5.06}, {"w": " indien.", "s": 5.06, "e": 5.34}]}, {"start": 5.48, "end": 9.32, "text": " Situé à 5 minutes du Capitole, direction la Maison du Curry pour tester leurs plats.", "words": [{"w": " Situé", "s": 5.48, "e": 5.76}, {"w": " à", "s": 5.76, "e": 5.96}, {"w": " 5", "s": 5.96, "e": 6.08}, {"w": " minutes", "s": 6.08, "e": 6.34}, {"w": " du", "s": 6.34, "e": 6.54}, {"w": " Capitole,", "s": 6.54, "e": 7.04}, {"w": " direction", "s": 7.18, "e": 7.56}, {"w": " la", "s": 7.56, "e": 7.92}, {"w": " Maison", "s": 7.92, "e": 8.14}, {"w": " du", "s": 8.14, "e": 8.32}, {"w": " Curry", "s": 8.32, "e": 8.54}, {"w": " pour", "s": 8.54, "e": 8.74}, {"w": " tester", "s": 8.74, "e": 9.0}, {"w": " leurs", "s": 9.0, "e": 9.22}, {"w": " plats.", "s": 9.22, "e": 9.32}]}, {"start": 9.44, "end": 11.22, "text": " On est personne, mais on a d'autres critiqués.", "words": [{"w": " On", "s": 9.44, "e": 9.5}, {"w": " est", "s": 9.5, "e": 9.66}, {"w": " personne,", "s": 9.66, "e": 10.16}, {"w": " mais", "s": 10.42, "e": 10.58}, {"w": " on", "s": 10.58, "e": 10.7}, {"w": " a", "s": 10.7, "e": 10.74}, {"w": " d", "s": 10.74, "e": 10.82}, {"w": "'autres", "s": 10.82, "e": 10.88}, {"w": " critiqués.", "s": 10.88, "e": 11.22}]}, {"start": 11.36, "end": 13.38, "text": " Par hasard, j'ai croisé Gab Lagourmand.", "words": [{"w": " Par", "s": 11.36, "e": 11.46}, {"w": " hasard,", "s": 11.46, "e": 11.86}, {"w": " j", "s": 11.94, "e": 12.02}, {"w": "'ai", "s": 12.02, "e": 12.16}, {"w": " croisé", "s": 12.16, "e": 12.66}, {"w": " Gab", "s": 12.66, "e": 12.84}, {"w": " Lagourmand.", "s": 12.84, "e": 13.38}]}, {"start": 13.42, "end": 15.28, "text": " Elle est super shy, je comprends pas pourquoi.", "words": [{"w": " Elle", "s": 13.42, "e": 13.58}, {"w": " est", "s": 13.58, "e": 13.78}, {"w": " super", "s": 13.78, "e": 14.16}, {"w": " shy,", "s": 14.16, "e": 14.4}, {"w": " je", "s": 14.44, "e": 14.66}, {"w": " comprends", "s": 14.66, "e": 14.92}, {"w": " pas", "s": 14.92, "e": 15.04}, {"w": " pourquoi.", "s": 15.04, "e": 15.28}]}, {"start": 15.32, "end": 18.02, "text": " On a également Antoine, notre exemple de socialisation.", "words": [{"w": " On", "s": 15.32, "e": 15.46}, {"w": " a", "s": 15.46, "e": 15.6}, {"w": " également", "s": 15.6, "e": 16.02}, {"w": " Antoine,", "s": 16.02, "e": 16.52}, {"w": " notre", "s": 16.72, "e": 16.78}, {"w": " exemple", "s": 16.78, "e": 17.14}, {"w": " de", "s": 17.14, "e": 17.44}, {"w": " socialisation.", "s": 17.44, "e": 18.02}]}, {"start": 18.18, "end": 19.4, "text": " Gab a beaucoup à apprendre de lui.", "words": [{"w": " Gab", "s": 18.18, "e": 18.38}, {"w": " a", "s": 18.38, "e": 18.54}, {"w": " beaucoup", "s": 18.54, "e": 18.82}, {"w": " à", "s": 18.82, "e": 18.98}, {"w": " apprendre", "s": 18.98, "e": 19.1}, {"w": " de", "s": 19.1, "e": 19.28}, {"w": " lui.", "s": 19.28, "e": 19.4}]}, {"start": 19.48, "end": 21.58, "text": " Et enfin, notre chouchou, Goose le Bulldog.", "words": [{"w": " Et", "s": 19.48, "e": 19.72}, {"w": " enfin,", "s": 19.72, "e": 20.0}, {"w": " notre", "s": 20.12, "e": 20.32}, {"w": " chouchou,", "s": 20.32, "e": 20.84}, {"w": " Goose", "s": 20.88, "e": 21.06}, {"w": " le", "s": 21.06, "e": 21.22}, {"w": " Bulldog.", "s": 21.22, "e": 21.58}]}, {"start": 21.72, "end": 23.44, "text": " Et ça, c'est moi, l'influenceur en carton.", "words": [{"w": " Et", "s": 21.72, "e": 21.88}, {"w": " ça,", "s": 21.88, "e": 22.18}, {"w": " c", "s": 22.26, "e": 22.34}, {"w": "'est", "s": 22.34, "e": 22.36}, {"w": " moi,", "s": 22.36, "e": 22.56}, {"w": " l", "s": 22.68, "e": 22.82}, {"w": "'influenceur", "s": 22.82, "e": 23.08}, {"w": " en", "s": 23.08, "e": 23.2}, {"w": " carton.", "s": 23.2, "e": 23.44}]}, {"start": 23.48, "end": 25.86, "text": " On commence avec un plat traditionnel à 15 euros.", "words": [{"w": " On", "s": 23.48, "e": 23.72}, {"w": " commence", "s": 23.72, "e": 23.98}, {"w": " avec", "s": 23.98, "e": 24.14}, {"w": " un", "s": 24.14, "e": 24.3}, {"w": " plat", "s": 24.3, "e": 24.48}, {"w": " traditionnel", "s": 24.48, "e": 25.2}, {"w": " à", "s": 25.2, "e": 25.46}, {"w": " 15", "s": 25.46, "e": 25.68}, {"w": " euros.", "s": 25.68, "e": 25.86}]}, {"start": 25.94, "end": 29.56, "text": " J'ai pris un poulet tikka masala avec un supplément épice.", "words": [{"w": " J", "s": 25.94, "e": 26.1}, {"w": "'ai", "s": 26.1, "e": 26.24}, {"w": " pris", "s": 26.24, "e": 26.48}, {"w": " un", "s": 26.48, "e": 26.8}, {"w": " poulet", "s": 26.8, "e": 27.04}, {"w": " tikka", "s": 27.04, "e": 27.3}, {"w": " masala", "s": 27.3, "e": 27.62}, {"w": " avec", "s": 27.62, "e": 28.44}, {"w": " un", "s": 28.44, "e": 28.62}, {"w": " supplément", "s": 28.62, "e": 29.12}, {"w": " épice.", "s": 29.12, "e": 29.56}]}, {"start": 29.56, "end": 30.52, "text": " 10 pour ce plat.", "words": [{"w": " 10", "s": 29.56, "e": 29.82}, {"w": " pour", "s": 29.82, "e": 29.96}, {"w": " ce", "s": 29.96, "e": 30.22}, {"w": " plat.", "s": 30.22, "e": 30.52}]}, {"start": 31.12, "end": 34.3, "text": " 9, parce que c'était incroyable, c'était relevé tout comme jamais.", "words": [{"w": " 9,", "s": 31.12, "e": 31.36}, {"w": " parce", "s": 31.48, "e": 31.66}, {"w": " que", "s": 31.66, "e": 31.7}, {"w": " c", "s": 31.7, "e": 31.86}, {"w": "'était", "s": 31.86, "e": 32.04}, {"w": " incroyable,", "s": 32.04, "e": 32.6}, {"w": " c", "s": 32.7, "e": 32.9}, {"w": "'était", "s": 32.9, "e": 33.16}, {"w": " relevé", "s": 33.16, "e": 33.78}, {"w": " tout", "s": 33.78, "e": 33.98}, {"w": " comme", "s": 33.98, "e": 34.14}, {"w": " jamais.", "s": 34.14, "e": 34.3}]}, {"start": 34.5, "end": 36.9, "text": " Après, je suis pas très objectif, j'aime beaucoup la nourriture indienne.", "words": [{"w": " Après,", "s": 34.5, "e": 34.64}, {"w": " je", "s": 34.66, "e": 34.74}, {"w": " suis", "s": 34.74, "e": 34.76}, {"w": " pas", "s": 34.76, "e": 34.86}, {"w": " très", "s": 34.86, "e": 35.06}, {"w": " objectif,", "s": 35.06, "e": 35.42}, {"w": " j", "s": 35.44, "e": 35.54}, {"w": "'aime", "s": 35.54, "e": 35.6}, {"w": " beaucoup", "s": 35.6, "e": 35.9}, {"w": " la", "s": 35.9, "e": 36.3}, {"w": " nourriture", "s": 36.3, "e": 36.6}, {"w": " indienne.", "s": 36.6, "e": 36.9}]}, {"start": 37.58, "end": 38.66, "text": " Donc, 9 solides, je recommande.", "words": [{"w": " Donc,", "s": 37.58, "e": 37.72}, {"w": " 9", "s": 37.72, "e": 37.86}, {"w": " solides,", "s": 37.86, "e": 38.18}, {"w": " je", "s": 38.22, "e": 38.34}, {"w": " recommande.", "s": 38.34, "e": 38.66}]}, {"start": 38.76, "end": 41.8, "text": " On enchaîne avec Goose et Gab pour un plat à 15 euros également.", "words": [{"w": " On", "s": 38.76, "e": 38.92}, {"w": " enchaîne", "s": 38.92, "e": 39.22}, {"w": " avec", "s": 39.22, "e": 39.5}, {"w": " Goose", "s": 39.5, "e": 39.78}, {"w": " et", "s": 39.78, "e": 40.06}, {"w": " Gab", "s": 40.06, "e": 40.24}, {"w": " pour", "s": 40.24, "e": 40.48}, {"w": " un", "s": 40.48, "e": 40.76}, {"w": " plat", "s": 40.76, "e": 40.82}, {"w": " à", "s": 40.82, "e": 41.06}, {"w": " 15", "s": 41.06, "e": 41.28}, {"w": " euros", "s": 41.28, "e": 41.48}, {"w": " également.", "s": 41.48, "e": 41.8}]}, {"start": 42.3, "end": 42.54, "text": " Salut !", "words": [{"w": " Salut", "s": 42.3, "e": 42.3}, {"w": " !", "s": 42.3, "e": 42.54}]}, {"start": 42.54, "end": 45.44, "text": " Qu'est-ce que vous avez pris ?", "words": [{"w": " Qu", "s": 42.54, "e": 42.6}, {"w": "'est", "s": 42.6, "e": 42.66}, {"w": "-ce", "s": 42.66, "e": 43.12}, {"w": " que", "s": 43.12, "e": 44.48}, {"w": " vous", "s": 44.48, "e": 44.62}, {"w": " avez", "s": 44.62, "e": 44.9}, {"w": " pris", "s": 44.9, "e": 45.1}, {"w": " ?", "s": 45.1, "e": 45.44}]}, {"start": 45.44, "end": 45.92, "text": " Un butter.", "words": [{"w": " Un", "s": 45.44, "e": 45.62}, {"w": " butter.", "s": 45.62, "e": 45.92}]}, {"start": 46.16, "end": 46.52, "text": " Chicken.", "words": [{"w": " Chicken.", "s": 46.16, "e": 46.52}]}, {"start": 46.72, "end": 48.04, "text": " Qu'y a-t-il dedans ?", "words": [{"w": " Qu", "s": 46.72, "e": 46.74}, {"w": "'y", "s": 46.74, "e": 46.76}, {"w": " a", "s": 46.76, "e": 46.84}, {"w": "-t", "s": 46.84, "e": 46.94}, {"w": "-il", "s": 46.94, "e": 46.94}, {"w": " dedans", "s": 46.94, "e": 47.34}, {"w": " ?", "s": 47.34, "e": 48.04}]}, {"start": 48.04, "end": 48.7, "text": " Du beurre.", "words": [{"w": " Du", "s": 48.04, "e": 48.28}, {"w": " beurre.", "s": 48.28, "e": 48.7}]}, {"start": 48.84, "end": 49.760000000000005, "text": " Hé, du chicken !", "words": [{"w": " Hé,", "s": 48.84, "e": 49.06}, {"w": " du", "s": 49.06, "e": 49.24}, {"w": " chicken", "s": 49.24, "e": 49.66}, {"w": " !", "s": 49.66, "e": 49.86}]}, {"start": 51.18, "end": 52.04, "text": " 10 pour ce plat.", "words": [{"w": " 10", "s": 51.18, "e": 51.4}, {"w": " pour", "s": 51.4, "e": 51.52}, {"w": " ce", "s": 51.52, "e": 51.8}, {"w": " plat.", "s": 51.8, "e": 52.04}]}, {"start": 53.44, "end": 53.82, "text": " 10.", "words": [{"w": " 10.", "s": 53.44, "e": 53.82}]}, {"start": 54.52, "end": 57.44, "text": " Moi, j'ai adoré une arène, le riz au jaspin, au cumin, pardon.", "words": [{"w": " Moi,", "s": 54.52, "e": 54.68}, {"w": " j", "s": 54.78, "e": 54.8}, {"w": "'ai", "s": 54.8, "e": 54.88}, {"w": " adoré", "s": 54.88, "e": 55.16}, {"w": " une", "s": 55.16, "e": 55.36}, {"w": " arène,", "s": 55.36, "e": 55.8}, {"w": " le", "s": 55.82, "e": 56.04}, {"w": " riz", "s": 56.04, "e": 56.18}, {"w": " au", "s": 56.18, "e": 56.28}, {"w": " jaspin,", "s": 56.28, "e": 56.72}, {"w": " au", "s": 56.78, "e": 57.0}, {"w": " cumin,", "s": 57.0, "e": 57.14}, {"w": " pardon.", "s": 57.28, "e": 57.44}]}, {"start": 57.6, "end": 58.34, "text": " Épicé comme il faut.", "words": [{"w": " Épicé", "s": 57.6, "e": 57.88}, {"w": " comme", "s": 57.88, "e": 58.12}, {"w": " il", "s": 58.12, "e": 58.28}, {"w": " faut.", "s": 58.28, "e": 58.34}]}, {"start": 58.34, "end": 60.64, "text": " J'ai pris le 1 sur 3.", "words": [{"w": " J", "s": 58.34, "e": 58.54}, {"w": "'ai", "s": 58.54, "e": 58.68}, {"w": " pris", "s": 58.68, "e": 59.0}, {"w": " le", "s": 59.0, "e": 59.28}, {"w": " 1", "s": 59.28, "e": 59.5}, {"w": " sur", "s": 59.5, "e": 60.06}, {"w": " 3.", "s": 60.06, "e": 60.64}]}, {"start": 60.68, "end": 60.88, "text": " Moi aussi.", "words": [{"w": " Moi", "s": 60.68, "e": 60.68}, {"w": " aussi.", "s": 60.68, "e": 60.88}]}, {"start": 61.56, "end": 62.46, "text": " On est pareils.", "words": [{"w": " On", "s": 61.56, "e": 61.62}, {"w": " est", "s": 61.62, "e": 61.82}, {"w": " pareils.", "s": 61.82, "e": 62.46}]}, {"start": 63.24, "end": 64.12, "text": " Ça fait trop cringe.", "words": [{"w": " Ça", "s": 63.24, "e": 63.34}, {"w": " fait", "s": 63.34, "e": 63.5}, {"w": " trop", "s": 63.5, "e": 63.82}, {"w": " cringe.", "s": 63.82, "e": 64.12}]}, {"start": 64.46, "end": 67.04, "text": " Et d'ailleurs gros big up à Karine Lafont qui aime beaucoup tes vidéos.", "words": [{"w": " Et", "s": 64.46, "e": 64.6}, {"w": " d", "s": 64.6, "e": 64.6}, {"w": "'ailleurs", "s": 64.6, "e": 64.9}, {"w": " gros", "s": 64.9, "e": 65.12}, {"w": " big", "s": 65.12, "e": 65.3}, {"w": " up", "s": 65.3, "e": 65.48}, {"w": " à", "s": 65.48, "e": 65.74}, {"w": " Karine", "s": 65.74, "e": 65.94}, {"w": " Lafont", "s": 65.94, "e": 66.12}, {"w": " qui", "s": 66.12, "e": 66.24}, {"w": " aime", "s": 66.24, "e": 66.34}, {"w": " beaucoup", "s": 66.34, "e": 66.56}, {"w": " tes", "s": 66.56, "e": 66.7}, {"w": " vidéos.", "s": 66.7, "e": 67.04}]}, {"start": 67.22, "end": 68.38, "text": " Et à Karine Le Marchand aussi.", "words": [{"w": " Et", "s": 67.22, "e": 67.26}, {"w": " à", "s": 67.26, "e": 67.38}, {"w": " Karine", "s": 67.38, "e": 67.58}, {"w": " Le", "s": 67.58, "e": 67.66}, {"w": " Marchand", "s": 67.66, "e": 67.94}, {"w": " aussi.", "s": 67.94, "e": 68.38}]}, {"start": 68.82, "end": 69.54, "text": " Elle est amourée dans le pré.", "words": [{"w": " Elle", "s": 68.82, "e": 68.9}, {"w": " est", "s": 68.9, "e": 68.96}, {"w": " amourée", "s": 68.96, "e": 69.18}, {"w": " dans", "s": 69.18, "e": 69.3}, {"w": " le", "s": 69.3, "e": 69.46}, {"w": " pré.", "s": 69.46, "e": 69.54}]}, {"start": 70.16, "end": 70.8, "text": " T'es gai toi.", "words": [{"w": " T", "s": 70.16, "e": 70.26}, {"w": "'es", "s": 70.26, "e": 70.4}, {"w": " gai", "s": 70.4, "e": 70.54}, {"w": " toi.", "s": 70.54, "e": 70.8}]}, {"start": 72.58, "end": 75.0, "text": " Donc, Karine, si tu veux venir manger avec nous, t'es la bienvenue.", "words": [{"w": " Donc,", "s": 72.58, "e": 72.84}, {"w": " Karine,", "s": 73.06, "e": 73.28}, {"w": " si", "s": 73.36, "e": 73.5}, {"w": " tu", "s": 73.5, "e": 73.6}, {"w": " veux", "s": 73.6, "e": 73.66}, {"w": " venir", "s": 73.66, "e": 73.86}, {"w": " manger", "s": 73.86, "e": 74.04}, {"w": " avec", "s": 74.04, "e": 74.26}, {"w": " nous,", "s": 74.26, "e": 74.46}, {"w": " t", "s": 74.56, "e": 74.58}, {"w": "'es", "s": 74.58, "e": 74.64}, {"w": " la", "s": 74.64, "e": 74.76}, {"w": " bienvenue.", "s": 74.76, "e": 75.0}]}]