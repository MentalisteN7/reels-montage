[{"start": 0.0, "end": 1.92, "text": " Où est-ce qu'on trouve cet Aligo de folie à Toulouse ?", "words": [{"w": " Où", "s": 0.0, "e": 0.18}, {"w": " est", "s": 0.18, "e": 0.26}, {"w": "-ce", "s": 0.26, "e": 0.26}, {"w": " qu", "s": 0.26, "e": 0.28}, {"w": "'on", "s": 0.28, "e": 0.34}, {"w": " trouve", "s": 0.34, "e": 0.44}, {"w": " cet", "s": 0.44, "e": 0.64}, {"w": " Aligo", "s": 0.64, "e": 0.82}, {"w": " de", "s": 0.82, "e": 1.12}, {"w": " folie", "s": 1.12, "e": 1.34}, {"w": " à", "s": 1.34, "e": 1.46}, {"w": " Toulouse", "s": 1.46, "e": 1.8}, {"w": " ?", "s": 1.8, "e": 1.92}]}, {"start": 1.92, "end": 3.66, "text": " Ce fromage coulant, c'est une dinguerie !", "words": [{"w": " Ce", "s": 1.92, "e": 2.06}, {"w": " fromage", "s": 2.06, "e": 2.4}, {"w": " coulant,", "s": 2.4, "e": 2.7}, {"w": " c", "s": 2.84, "e": 2.96}, {"w": "'est", "s": 2.96, "e": 3.02}, {"w": " une", "s": 3.02, "e": 3.24}, {"w": " dinguerie", "s": 3.24, "e": 3.6}, {"w": " !", "s": 3.6, "e": 3.66}]}, {"start": 3.66, "end": 7.04, "text": " Moi c'est Ari, l'influenceur en carton, et je me charge de vous trouver des bonnes adresses pour cet hiver.", "words": [{"w": " Moi", "s": 3.66, "e": 3.74}, {"w": " c", "s": 3.74, "e": 3.92}, {"w": "'est", "s": 3.92, "e": 4.08}, {"w": " Ari,", "s": 4.08, "e": 4.22}, {"w": " l", "s": 4.3, "e": 4.4}, {"w": "'influenceur", "s": 4.4, "e": 4.74}, {"w": " en", "s": 4.74, "e": 4.86}, {"w": " carton,", "s": 4.86, "e": 5.08}, {"w": " et", "s": 5.16, "e": 5.2}, {"w": " je", "s": 5.2, "e": 5.3}, {"w": " me", "s": 5.3, "e": 5.46}, {"w": " charge", "s": 5.46, "e": 5.56}, {"w": " de", "s": 5.56, "e": 5.68}, {"w": " vous", "s": 5.68, "e": 5.78}, {"w": " trouver", "s": 5.78, "e": 5.92}, {"w": " des", "s": 5.92, "e": 6.14}, {"w": " bonnes", "s": 6.14, "e": 6.38}, {"w": " adresses", "s": 6.38, "e": 6.58}, {"w": " pour", "s": 6.58, "e": 6.74}, {"w": " cet", "s": 6.74, "e": 6.86}, {"w": " hiver.", "s": 6.86, "e": 7.04}]}, {"start": 7.12, "end": 9.12, "text": " Je vous réserve d'ailleurs une belle surprise en fin de vidéo.", "words": [{"w": " Je", "s": 7.12, "e": 7.22}, {"w": " vous", "s": 7.22, "e": 7.36}, {"w": " réserve", "s": 7.36, "e": 7.58}, {"w": " d", "s": 7.58, "e": 7.66}, {"w": "'ailleurs", "s": 7.66, "e": 7.76}, {"w": " une", "s": 7.76, "e": 7.96}, {"w": " belle", "s": 7.96, "e": 8.12}, {"w": " surprise", "s": 8.12, "e": 8.42}, {"w": " en", "s": 8.42, "e": 8.64}, {"w": " fin", "s": 8.64, "e": 8.74}, {"w": " de", "s": 8.74, "e": 8.96}, {"w": " vidéo.", "s": 8.96, "e": 9.12}]}, {"start": 9.18, "end": 12.12, "text": " On se retrouve au Ligo, la Saint-Georges, meilleure place de Toulouse by the way.", "words": [{"w": " On", "s": 9.18, "e": 9.2}, {"w": " se", "s": 9.2, "e": 9.36}, {"w": " retrouve", "s": 9.36, "e": 9.58}, {"w": " au", "s": 9.58, "e": 9.72}, {"w": " Ligo,", "s": 9.72, "e": 9.98}, {"w": " la", "s": 10.08, "e": 10.32}, {"w": " Saint", "s": 10.32, "e": 10.5}, {"w": "-Georges,", "s": 10.5, "e": 10.72}, {"w": " meilleure", "s": 10.88, "e": 11.06}, {"w": " place", "s": 11.06, "e": 11.16}, {"w": " de", "s": 11.16, "e": 11.34}, {"w": " Toulouse", "s": 11.34, "e": 11.56}, {"w": " by", "s": 11.56, "e": 11.78}, {"w": " the", "s": 11.78, "e": 11.98}, {"w": " way.", "s": 11.98, "e": 12.12}]}, {"start": 12.2, "end": 15.34, "text": " C'est le seul endroit que je connaisse en centre-ville où la spécialité est l'Aligo.", "words": [{"w": " C", "s": 12.2, "e": 12.28}, {"w": "'est", "s": 12.28, "e": 12.32}, {"w": " le", "s": 12.32, "e": 12.46}, {"w": " seul", "s": 12.46, "e": 12.58}, {"w": " endroit", "s": 12.58, "e": 12.78}, {"w": " que", "s": 12.78, "e": 12.92}, {"w": " je", "s": 12.92, "e": 13.08}, {"w": " connaisse", "s": 13.08, "e": 13.38}, {"w": " en", "s": 13.38, "e": 13.54}, {"w": " centre", "s": 13.54, "e": 13.8}, {"w": "-ville", "s": 13.8, "e": 13.92}, {"w": " où", "s": 13.92, "e": 14.04}, {"w": " la", "s": 14.04, "e": 14.22}, {"w": " spécialité", "s": 14.22, "e": 14.68}, {"w": " est", "s": 14.68, "e": 14.9}, {"w": " l", "s": 14.9, "e": 15.1}, {"w": "'Aligo.", "s": 15.1, "e": 15.34}]}, {"start": 15.38, "end": 16.96, "text": " On le teste de suite avec les copains.", "words": [{"w": " On", "s": 15.38, "e": 15.46}, {"w": " le", "s": 15.46, "e": 15.66}, {"w": " teste", "s": 15.66, "e": 15.84}, {"w": " de", "s": 15.84, "e": 16.12}, {"w": " suite", "s": 16.12, "e": 16.32}, {"w": " avec", "s": 16.32, "e": 16.58}, {"w": " les", "s": 16.58, "e": 16.74}, {"w": " copains.", "s": 16.74, "e": 16.96}]}, {"start": 17.08, "end": 18.24, "text": " Roro le sage pour les entrées.", "words": [{"w": " Roro", "s": 17.08, "e": 17.32}, {"w": " le", "s": 17.32, "e": 17.58}, {"w": " sage", "s": 17.58, "e": 17.72}, {"w": " pour", "s": 17.72, "e": 17.9}, {"w": " les", "s": 17.9, "e": 18.12}, {"w": " entrées.", "s": 18.12, "e": 18.24}]}, {"start": 18.32, "end": 21.5, "text": " Au niveau des entrées, j'ai pris les farsous et le fricando.", "words": [{"w": " Au", "s": 18.32, "e": 18.34}, {"w": " niveau", "s": 18.34, "e": 18.52}, {"w": " des", "s": 18.52, "e": 18.8}, {"w": " entrées,", "s": 18.8, "e": 18.98}, {"w": " j", "s": 19.02, "e": 19.1}, {"w": "'ai", "s": 19.1, "e": 19.18}, {"w": " pris", "s": 19.18, "e": 19.38}, {"w": " les", "s": 19.38, "e": 19.74}, {"w": " farsous", "s": 19.74, "e": 20.24}, {"w": " et", "s": 20.24, "e": 20.7}, {"w": " le", "s": 20.7, "e": 21.1}, {"w": " fricando.", "s": 21.1, "e": 21.5}]}, {"start": 21.52, "end": 23.2, "text": " Il y avait aussi des croquettes à l'Aligo.", "words": [{"w": " Il", "s": 21.52, "e": 21.6}, {"w": " y", "s": 21.6, "e": 21.6}, {"w": " avait", "s": 21.6, "e": 21.64}, {"w": " aussi", "s": 21.64, "e": 21.88}, {"w": " des", "s": 21.88, "e": 22.14}, {"w": " croquettes", "s": 22.14, "e": 22.62}, {"w": " à", "s": 22.62, "e": 22.8}, {"w": " l", "s": 22.8, "e": 22.9}, {"w": "'Aligo.", "s": 22.9, "e": 23.2}]}, {"start": 23.2, "end": 25.1, "text": " Bon, les croquettes, je pensais que ça allait être le meilleur,", "words": [{"w": " Bon,", "s": 23.2, "e": 23.36}, {"w": " les", "s": 23.46, "e": 23.64}, {"w": " croquettes,", "s": 23.64, "e": 23.88}, {"w": " je", "s": 24.0, "e": 24.0}, {"w": " pensais", "s": 24.0, "e": 24.16}, {"w": " que", "s": 24.16, "e": 24.26}, {"w": " ça", "s": 24.26, "e": 24.36}, {"w": " allait", "s": 24.36, "e": 24.46}, {"w": " être", "s": 24.46, "e": 24.56}, {"w": " le", "s": 24.56, "e": 24.8}, {"w": " meilleur,", "s": 24.8, "e": 25.1}]}, {"start": 25.26, "end": 28.36, "text": " mais c'était vraiment fricando, le pâté qui était excellent.", "words": [{"w": " mais", "s": 25.26, "e": 25.52}, {"w": " c", "s": 25.52, "e": 25.58}, {"w": "'était", "s": 25.58, "e": 25.68}, {"w": " vraiment", "s": 25.68, "e": 26.32}, {"w": " fricando,", "s": 26.32, "e": 26.94}, {"w": " le", "s": 27.1, "e": 27.28}, {"w": " pâté", "s": 27.28, "e": 27.56}, {"w": " qui", "s": 27.56, "e": 27.74}, {"w": " était", "s": 27.74, "e": 27.94}, {"w": " excellent.", "s": 27.94, "e": 28.36}]}, {"start": 28.54, "end": 31.78, "text": " Et le farsous, c'était vraiment une espèce de petite galette de légumes.", "words": [{"w": " Et", "s": 28.54, "e": 28.74}, {"w": " le", "s": 28.74, "e": 28.82}, {"w": " farsous,", "s": 28.82, "e": 29.2}, {"w": " c", "s": 29.24, "e": 29.42}, {"w": "'était", "s": 29.42, "e": 29.56}, {"w": " vraiment", "s": 29.56, "e": 29.86}, {"w": " une", "s": 29.86, "e": 30.02}, {"w": " espèce", "s": 30.02, "e": 30.26}, {"w": " de", "s": 30.26, "e": 30.46}, {"w": " petite", "s": 30.46, "e": 30.64}, {"w": " galette", "s": 30.64, "e": 31.1}, {"w": " de", "s": 31.1, "e": 31.44}, {"w": " légumes.", "s": 31.44, "e": 31.78}]}, {"start": 31.88, "end": 32.62, "text": " Très très bonne surprise.", "words": [{"w": " Très", "s": 31.88, "e": 32.06}, {"w": " très", "s": 32.06, "e": 32.18}, {"w": " bonne", "s": 32.18, "e": 32.28}, {"w": " surprise.", "s": 32.28, "e": 32.62}]}, {"start": 32.76, "end": 35.34, "text": " Du coup, pour les entrées, je vais mettre la note de 8.", "words": [{"w": " Du", "s": 32.76, "e": 32.98}, {"w": " coup,", "s": 32.98, "e": 33.12}, {"w": " pour", "s": 33.24, "e": 33.32}, {"w": " les", "s": 33.32, "e": 33.6}, {"w": " entrées,", "s": 33.6, "e": 33.82}, {"w": " je", "s": 33.88, "e": 33.96}, {"w": " vais", "s": 33.96, "e": 34.04}, {"w": " mettre", "s": 34.04, "e": 34.22}, {"w": " la", "s": 34.22, "e": 34.42}, {"w": " note", "s": 34.42, "e": 34.54}, {"w": " de", "s": 34.54, "e": 35.08}, {"w": " 8.", "s": 35.08, "e": 35.34}]}, {"start": 35.48, "end": 36.16, "text": " Ça me semble mérité.", "words": [{"w": " Ça", "s": 35.48, "e": 35.58}, {"w": " me", "s": 35.58, "e": 35.72}, {"w": " semble", "s": 35.72, "e": 35.84}, {"w": " mérité.", "s": 35.84, "e": 36.16}]}, {"start": 36.18, "end": 39.32, "text": " Anto, mon ami d'enfance depuis un an, avec Erwan le rugbyman pour les plats.", "words": [{"w": " Anto,", "s": 36.18, "e": 36.5}, {"w": " mon", "s": 36.58, "e": 36.68}, {"w": " ami", "s": 36.68, "e": 36.78}, {"w": " d", "s": 36.78, "e": 36.84}, {"w": "'enfance", "s": 36.84, "e": 37.12}, {"w": " depuis", "s": 37.12, "e": 37.38}, {"w": " un", "s": 37.38, "e": 37.6}, {"w": " an,", "s": 37.6, "e": 37.72}, {"w": " avec", "s": 37.92, "e": 38.02}, {"w": " Erwan", "s": 38.02, "e": 38.28}, {"w": " le", "s": 38.28, "e": 38.46}, {"w": " rugbyman", "s": 38.46, "e": 38.88}, {"w": " pour", "s": 38.88, "e": 39.02}, {"w": " les", "s": 39.02, "e": 39.24}, {"w": " plats.", "s": 39.24, "e": 39.32}]}, {"start": 39.4, "end": 44.78, "text": " Alors moi, j'ai pris un demi-magret de canard avec de l'Aligo et une sauce miel-tan.", "words": [{"w": " Alors", "s": 39.4, "e": 39.62}, {"w": " moi,", "s": 39.62, "e": 39.9}, {"w": " j", "s": 39.94, "e": 40.02}, {"w": "'ai", "s": 40.02, "e": 40.16}, {"w": " pris", "s": 40.16, "e": 40.3}, {"w": " un", "s": 40.3, "e": 40.56}, {"w": " demi", "s": 40.56, "e": 40.74}, {"w": "-magret", "s": 40.74, "e": 41.04}, {"w": " de", "s": 41.04, "e": 41.26}, {"w": " canard", "s": 41.26, "e": 41.6}, {"w": " avec", "s": 41.6, "e": 42.16}, {"w": " de", "s": 42.16, "e": 42.5}, {"w": " l", "s": 42.5, "e": 42.62}, {"w": "'Aligo", "s": 42.62, "e": 42.96}, {"w": " et", "s": 42.96, "e": 43.38}, {"w": " une", "s": 43.38, "e": 43.66}, {"w": " sauce", "s": 43.66, "e": 44.16}, {"w": " miel", "s": 44.16, "e": 44.64}, {"w": "-tan.", "s": 44.64, "e": 44.78}]}, {"start": 44.8, "end": 46.56, "text": " Je suis passé super bien avec le magret.", "words": [{"w": " Je", "s": 44.8, "e": 44.84}, {"w": " suis", "s": 44.84, "e": 44.98}, {"w": " passé", "s": 44.98, "e": 45.22}, {"w": " super", "s": 45.22, "e": 45.6}, {"w": " bien", "s": 45.6, "e": 45.8}, {"w": " avec", "s": 45.8, "e": 46.18}, {"w": " le", "s": 46.18, "e": 46.4}, {"w": " magret.", "s": 46.4, "e": 46.56}]}, {"start": 46.64, "end": 49.22, "text": " Et bien moi, j'ai pris une souris d'agneau et son animation Aligo,", "words": [{"w": " Et", "s": 46.64, "e": 46.8}, {"w": " bien", "s": 46.8, "e": 46.84}, {"w": " moi,", "s": 46.84, "e": 46.96}, {"w": " j", "s": 46.96, "e": 47.08}, {"w": "'ai", "s": 47.08, "e": 47.12}, {"w": " pris", "s": 47.12, "e": 47.24}, {"w": " une", "s": 47.24, "e": 47.44}, {"w": " souris", "s": 47.44, "e": 47.74}, {"w": " d", "s": 47.74, "e": 47.86}, {"w": "'agneau", "s": 47.86, "e": 48.04}, {"w": " et", "s": 48.04, "e": 48.28}, {"w": " son", "s": 48.28, "e": 48.44}, {"w": " animation", "s": 48.44, "e": 48.86}, {"w": " Aligo,", "s": 48.86, "e": 49.22}]}, {"start": 49.34, "end": 50.96, "text": " on te l'a fait couler jusque dans l'assiette.", "words": [{"w": " on", "s": 49.34, "e": 49.4}, {"w": " te", "s": 49.4, "e": 49.48}, {"w": " l", "s": 49.48, "e": 49.56}, {"w": "'a", "s": 49.56, "e": 49.56}, {"w": " fait", "s": 49.56, "e": 49.82}, {"w": " couler", "s": 49.82, "e": 50.3}, {"w": " jusque", "s": 50.3, "e": 50.56}, {"w": " dans", "s": 50.56, "e": 50.66}, {"w": " l", "s": 50.66, "e": 50.8}, {"w": "'assiette.", "s": 50.8, "e": 50.96}]}, {"start": 51.0, "end": 51.98, "text": " Et c'était exceptionnel.", "words": [{"w": " Et", "s": 51.0, "e": 51.12}, {"w": " c", "s": 51.12, "e": 51.2}, {"w": "'était", "s": 51.2, "e": 51.4}, {"w": " exceptionnel.", "s": 51.4, "e": 51.98}]}, {"start": 51.98, "end": 54.44, "text": " Eh bien, je pense qu'on a été consulté, c'est un bon oeuf.", "words": [{"w": " Eh", "s": 51.98, "e": 52.18}, {"w": " bien,", "s": 52.18, "e": 52.32}, {"w": " je", "s": 52.36, "e": 52.4}, {"w": " pense", "s": 52.4, "e": 52.58}, {"w": " qu", "s": 52.58, "e": 52.7}, {"w": "'on", "s": 52.7, "e": 52.78}, {"w": " a", "s": 52.78, "e": 52.88}, {"w": " été", "s": 52.88, "e": 53.12}, {"w": " consulté,", "s": 53.12, "e": 53.7}, {"w": " c", "s": 53.78, "e": 53.94}, {"w": "'est", "s": 53.94, "e": 54.04}, {"w": " un", "s": 54.04, "e": 54.16}, {"w": " bon", "s": 54.16, "e": 54.4}, {"w": " oeuf.", "s": 54.4, "e": 54.44}]}, {"start": 54.54, "end": 56.38, "text": " C'est un oeuf, franchement, c'était super bon.", "words": [{"w": " C", "s": 54.54, "e": 54.54}, {"w": "'est", "s": 54.54, "e": 54.68}, {"w": " un", "s": 54.68, "e": 54.78}, {"w": " oeuf,", "s": 54.78, "e": 55.1}, {"w": " franchement,", "s": 55.26, "e": 55.66}, {"w": " c", "s": 55.7, "e": 55.86}, {"w": "'était", "s": 55.86, "e": 55.94}, {"w": " super", "s": 55.94, "e": 56.24}, {"w": " bon.", "s": 56.24, "e": 56.38}]}, {"start": 56.5, "end": 57.8, "text": " Un bon plat du Toulousain, pas du tout.", "words": [{"w": " Un", "s": 56.5, "e": 56.62}, {"w": " bon", "s": 56.62, "e": 56.8}, {"w": " plat", "s": 56.8, "e": 56.94}, {"w": " du", "s": 56.94, "e": 57.12}, {"w": " Toulousain,", "s": 57.12, "e": 57.4}, {"w": " pas", "s": 57.48, "e": 57.56}, {"w": " du", "s": 57.56, "e": 57.64}, {"w": " tout.", "s": 57.64, "e": 57.8}]}, {"start": 58.0, "end": 59.08, "text": " En valide, il a pas compris le concept.", "words": [{"w": " En", "s": 58.0, "e": 58.0}, {"w": " valide,", "s": 58.0, "e": 58.14}, {"w": " il", "s": 58.26, "e": 58.36}, {"w": " a", "s": 58.36, "e": 58.46}, {"w": " pas", "s": 58.46, "e": 58.62}, {"w": " compris", "s": 58.62, "e": 58.8}, {"w": " le", "s": 58.8, "e": 58.92}, {"w": " concept.", "s": 58.92, "e": 59.08}]}, {"s