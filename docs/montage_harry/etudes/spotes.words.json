.86, "e": 9.0}, {"w": " me", "s": 9.0, "e": 9.16}, {"w": " démène", "s": 9.16, "e": 9.38}, {"w": " pour", "s": 9.38, "e": 9.52}, {"w": " vous", "s": 9.52, "e": 9.7}, {"w": " trouver", "s": 9.7, "e": 9.82}, {"w": " des", "s": 9.82, "e": 10.0}, {"w": " pépites", "s": 10.0, "e": 10.4}, {"w": " à", "s": 10.4, "e": 10.58}, {"w": " Toulouse.", "s": 10.58, "e": 10.9}]}, {"start": 11.1, "end": 12.58, "text": " Aujourd'hui, direction Spot.", "words": [{"w": " Aujourd", "s": 11.1, "e": 11.28}, {"w": "'hui,", "s": 11.28, "e": 11.46}, {"w": " direction", "s": 11.6, "e": 12.06}, {"w": " Spot.", "s": 12.06, "e": 12.58}]}, {"start": 12.66, "end": 15.08, "text": " Il est bien caché, c'est par hasard que je suis tombé dessus.", "words": [{"w": " Il", "s": 12.66, "e": 12.8}, {"w": " est", "s": 12.8, "e": 12.92}, {"w": " bien", "s": 12.92, "e": 13.16}, {"w": " caché,", "s": 13.16, "e": 13.52}, {"w": " c", "s": 13.58, "e": 13.62}, {"w": "'est", "s": 13.62, "e": 13.74}, {"w": " par", "s": 13.74, "e": 14.0}, {"w": " hasard", "s": 14.0, "e": 14.28}, {"w": " que", "s": 14.28, "e": 14.38}, {"w": " je", "s": 14.38, "e": 14.5}, {"w": " suis", "s": 14.5, "e": 14.62}, {"w": " tombé", "s": 14.62, "e": 14.88}, {"w": " dessus.", "s": 14.88, "e": 15.08}]}, {"start": 15.18, "end": 18.34, "text": " L'endroit est très détente, avec un mur de brique Toulouseing, j'adore.", "words": [{"w": " L", "s": 15.18, "e": 15.3}, {"w": "'endroit", "s": 15.3, "e": 15.56}, {"w": " est", "s": 15.56, "e": 15.8}, {"w": " très", "s": 15.8, "e": 15.92}, {"w": " détente,", "s": 15.92, "e": 16.36}, {"w": " avec", "s": 16.48, "e": 16.68}, {"w": " un", "s": 16.68, "e": 16.86}, {"w": " mur", "s": 16.86, "e": 16.96}, {"w": " de", "s": 16.96, "e": 17.2}, {"w": " brique", "s": 17.2, "e": 17.36}, {"w": " Toulouseing,", "s": 17.36, "e": 17.84}, {"w": " j", "s": 17.94, "e": 18.12}, {"w": "'adore.", "s": 18.12, "e": 18.34}]}, {"start": 18.44, "end": 21.46, "text": " Les sandwichs sont à partir de 7€, parfait pour la fin du mois.", "