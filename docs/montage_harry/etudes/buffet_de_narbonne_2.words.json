[{"start": 0.0, "end": 3.44, "text": " Pauvre, tu as pris deux kilos au plus grand Buffet d'Europe.", "words": [{"w": " Pauvre,", "s": 0.0, "e": 0.48}, {"w": " tu", "s": 0.7, "e": 0.78}, {"w": " as", "s": 0.78, "e": 1.0}, {"w": " pris", "s": 1.0, "e": 1.14}, {"w": " deux", "s": 1.14, "e": 1.36}, {"w": " kilos", "s": 1.36, "e": 1.56}, {"w": " au", "s": 1.56, "e": 1.74}, {"w": " plus", "s": 1.74, "e": 2.04}, {"w": " grand", "s": 2.04, "e": 2.22}, {"w": " Buffet", "s": 2.22, "e": 2.56}, {"w": " d", "s": 2.56, "e": 2.74}, {"w": "'Europe.", "s": 2.74, "e": 3.44}]}, {"start": 3.88, "end": 7.92, "text": " Avec mon équipe de troubadours, on est parti mettre en faillite le plus grand Buffet d'Europe,", "words": [{"w": " Avec", "s": 3.88, "e": 3.96}, {"w": " mon", "s": 3.96, "e": 4.2}, {"w": " équipe", "s": 4.2, "e": 4.42}, {"w": " de", "s": 4.42, "e": 4.66}, {"w": " troubadours,", "s": 4.66, "e": 5.16}, {"w": " on", "s": 5.26, "e": 5.36}, {"w": " est", "s": 5.36, "e": 5.54}, {"w": " parti", "s": 5.54, "e": 5.74}, {"w": " mettre", "s": 5.74, "e": 6.0}, {"w": " en", "s": 6.0, "e": 6.3}, {"w": " faillite", "s": 6.3, "e": 6.64}, {"w": " le", "s": 6.64, "e": 6.88}, {"w": " plus", "s": 6.88, "e": 7.1}, {"w": " grand", "s": 7.1, "e": 7.22}, {"w": " Buffet", "s": 7.22, "e": 7.5}, {"w": " d", "s": 7.5, "e": 7.7}, {"w": "'Europe,", "s": 7.7, "e": 7.92}]}, {"start": 8.14, "end": 13.26, "text": " tel de pieutre-chevalier affamé, direction Narbonne, dans une petite charrette mais chargée", "words": [{"w": " tel", "s": 8.14, "e": 8.28}, {"w": " de", "s": 8.28, "e": 8.58}, {"w": " pieutre", "s": 8.58, "e": 8.98}, {"w": "-chevalier", "s": 8.98, "e": 9.56}, {"w": " affamé,", "s": 9.56, "e": 10.0}, {"w": " direction", "s": 10.12, "e": 10.72}, {"w": " Narbonne,", "s": 10.72, "e": 11.36}, {"w": " dans", "s": 11.42, "e": 11.58}, {"w": " une", "s": 11.58, "e": 11.82}, {"w": " petite", "s": 11.82, "e": 12.14}, {"w": " charrette", "s": 12.14, "e": 12.58}, {"w": " mais", "s": 12.58, "e": 12.9}, {"w": " chargée", "s": 12.9, "e": 13.26}]}, {"start": 13.26, "end": 14.2, "text": " comme un convoi royal.", "words": [{"w": " comme", "s": 13.26, "e": 13.42}, {"w": " un", "s": 13.42, "e": 13.66}, {"w": " convoi", "s": 13.66, "e": 13.86}, {"w": " royal.", "s": 13.86, "e": 14.2}]}, {"start": 14.3, "end": 18.34, "text": " Le Buffet possède sa propre balance, mais je l'ai cassé la dernière, donc j'ai", "words": [{"w": " Le", "s": 14.3, "e": 14.46}, {"w": " Buffet", "s": 14.46, "e": 14.86}, {"w": " possède", "s": 14.86, "e": 15.32}, {"w": " sa", "s": 15.32, "e": 15.64}, {"w": " propre", "s": 15.64, "e": 15.9}, {"w": " balance,", "s": 15.9, "e": 16.32}, {"w": " mais", "s": 16.48, "e": 16.6}, {"w": " je", "s": 16.6, "e": 16.8}, {"w": " l", "s": 16.8, "e": 16.82}, {"w": "'ai", "s": 16.82, "e": 16.94}, {"w": " cassé", "s": 16.94, "e": 17.14}, {"w": " la", "s": 17.14, "e": 17.24}, {"w": " dernière,", "s": 17.24, "e": 17.6}, {"w": " donc", "s": 17.7, "e": 18.04}, {"w": " j", "s": 18.04, "e": 18.26}, {"w": "'ai", "s": 18.26, "e": 18.34}]}, {"start": 18.34, "end": 18.8, "text": " pris la mienne.", "words": [{"w": " pris", "s": 18.34, "e": 18.48}, {"w": " la", "s": 18.48, "e": 18.64}, {"w": " mienne.", "s": 18.64, "e": 18.8}]}, {"start": 18.92, "end": 22.18, "text": " On s'est tous pesé avant notre petite compétition burlesque.", "words": [{"w": " On", "s": 18.92, "e": 19.04}, {"w": " s", "s": 19.04, "e": 19.18}, {"w": "'est", "s": 19.18, "e": 19.24}, {"w": " tous", "s": 19.24, "e": 19.52}, {"w": " pesé", "s": 19.52, "e": 19.92}, {"w": " avant", "s": 19.92, "e": 20.16}, {"w": " notre", "s": 20.16, "e": 20.44}, {"w": " petite", "s": 20.44, "e": 20.94}, {"w": " compétition", "s": 20.94, "e": 21.52}, {"w": " burlesque.", "s": 21.52, "e": 22.18}]}, {"start": 22.28, "end": 23.08, "text": " Ah ouais ?", "words": [{"w": " Ah", "s": 22.28, "e": 22.42}, {"w": " ouais", "s": 22.42, "e": 22.6}, {"w": " ?", "s": 22.6, "e": 23.08}]}, {"start": 23.08, "end": 26.24, "text": " À peine installé, qu'on fonce direct au Buffet, 100 fois ni loi.", "words": [{"w": " À", "s": 23.08, "e": 23.22}, {"w": " peine", "s": 23.22, "e": 23.42}, {"w": " installé,", "s": 23.42, "e": 23.88}, {"w": " qu", "s": 24.02, "e": 24.14}, {"w": "'on", "s": 24.14, "e": 24.14}, {"w": " fonce", "s": 24.14, "e": 24.32}, {"w": " direct", "s": 24.32, "e": 24.64}, {"w": " au", "s": 24.64, "e": 24.76}, {"w": " Buffet,", "s": 24.76, "e": 25.12}, {"w": " 100", "s": 25.26, "e": 25.42}, {"w": " fois", "s": 25.42, "e": 25.8}, {"w": " ni", "s": 25.8, "e": 26.06}, {"w": " loi.", "s": 26.06, "e": 26.24}]}, {"start": 26.24, "end": 31.82, "text": " Omar, huîtres, crabes, cavières des pauvres, le banquet est rempli de victuailles délicieuses.", "words": [{"w": " Omar,", "s": 26.24, "e": 26.88}, {"w": " huîtres,", "s": 27.18, "e": 27.56}, {"w": " crabes,", "s": 27.78, "e": 28.12}, {"w": " cavières", "s": 28.32, "e": 28.58}, {"w": " des", "s": 28.58, "e": 28.82}, {"w": " pauvres,", "s": 28.82, "e": 29.1}, {"w": " le", "s": 29.24, "e": 29.44}, {"w": " banquet", "s": 29.44, "e": 29.74}, {"w": " est", "s": 29.74, "e": 30.04}, {"w": " rempli", "s": 30.04, "e": 30.28}, {"w": " de", "s": 30.28, "e": 30.56}, {"w": " victuailles", "s": 30.56, "e": 31.2}, {"w": " délicieuses.", "s": 31.2, "e": 31.82}]}, {"start": 31.88, "end": 32.46, "text": " Tout y passe.", "words": [{"w": " Tout", "s": 31.88, "e": 32.02}, {"w": " y", "s": 32.02, "e": 32.24}, {"w": " passe.", "s": 32.24, "e": 32.46}]}, {"start": 32.64, "end": 36.62, "text": " On enchaîne bien sûr avec le foie gras et le fromage, le trésor du terroir.", "words": [{"w": " On", "s": 32.64, "e": 32.86}, {"w": " enchaîne", "s": 32.86, "e": 33.12}, {"w": " bien", "s": 33.12, "e": 33.38}, {"w": " sûr", "s": 33.38, "e": 33.6}, {"w": " avec", "s": 33.6, "e": 33.96}, {"w": " le", "s": 33.96, "e": 34.24}, {"w": " foie", "s": 34.24, "e": 34.42}, {"w": " gras", "s": 34.42, "e": 34.56}, {"w": " et", "s": 34.56, "e": 34.78}, {"w": " le", "s": 34.78, "e": 35.0}, {"w": " fromage,", "s": 35.0, "e": 35.32}, {"w": " le", "s": 35.52, "e": 35.66}, {"w": " trésor", "s": 35.66, "e": 35.96}, {"w": " du", "s": 35.96, "e": 36.2}, {"w": " terroir.", "s": 36.2, "e": 36.62}]}, {"start": 36.8, "end": 39.06, "text": " Goose se régale, il a une fin de bulldog.", "words": [{"w": " Goose", "s": 36.8, "e": 37.0}, {"w": " se", "s": 37.0, "e": 37.36}, {"w": " régale,", "s": 37.36, "e": 37.78}, {"w": " il", "s": 37.84, "e": 37.98}, {"w": " a", "s": 37.98, "e": 38.04}, {"w": " une", "s": 38.04, "e": 38.3}, {"w": " fin", "s": 38.3, "e": 38.42}, {"w": " de", "s": 38.42, "e": 38.68}, {"w": " bulldog.", "s": 38.68, "e": 39.06}]}, {"start": 39.18, "end": 42.06, "text": " Ça va être dur de le battre, mais on lâche rien, tout pour la gloire.", "words": [{"w": " Ça", "s": 39.18, "e": 39.3}, {"w": " va", "s": 39.3, "e": 39.42}, {"w": " être", "s": 39.42, "e": 39.66}, {"w": " dur", "s": 39.66, "e": 39.82}, {"w": " de", "s": 39.82, "e": 39.98}, {"w": " le", "s": 39.98, "e": 40.14}, {"w": " battre,", "s": 40.14, "e": 40.32}, {"w": " mais", "s": 40.4, "e": 40.48}, {"w": " on", "s": 40.48, "e": 40.66}, {"w": " lâche", "s": 40.66, "e": 40.94}, {"w": " rien,", "s": 40.94, "e": 41.16}, {"w": " tout", "s": 41.3, "e": 41.44}, {"w": " pour", "s": 41.44, "e": 41.66}, {"w": " la", "s": 41.66, "e": 41.86}, {"w": " gloire.", "s": 41.86, "e": 42.06}]}, {"start": 42.18, "end": 43.42, "text": " On démarre avec les plachos.", "words": [{"w": " On", "s": 42.18, "e": 42.38}, {"w": " démarre", "s": 42.38, "e": 42.7}, {"w": " avec", "s": 42.7, "e": 42.92}, {"w": " les", "s": 42.92, "e": 43.12}, {"w": " plachos.", "s": 43.12, "e": 43.42}]}, {"start": 43.52, "end": 45.72, "text": " J'ai pris pour la première fois de l'andouillette.", "words": [{"w": " J", "s": 43.52, "e": 43.66}, {"w": "'ai", "s": 43.66, "e": 43.72}, {"w": " pris", "s": 43.72, "e": 43.86}, {"w": " pour", "s": 43.86, "e": 44.04}, {"w": " la", "s": 44.04, "e": 44.34}, {"w": " première", "s": 44.34, "e": 44.54}, {"w": " fois", "s": 44.54, "e": 44.82}, {"w": " de", "s": 44.82, "e": 45.08}, {"w": " l", "s": 45.08, "e": 45.2}, {"w": "'andouillette.", "s": 45.2, "e": 45.72}]}, {"start": 46.06, "end": 48.86, "text": " Au grand jamais j'en reprends, ça pue la mort ce truc.", "words": [{"w": " Au", "s": 46.06, "e": 46.3}, {"w": " grand", "s": 46.3, "e": 46.52}, {"w": " jamais", "s": 46.52, "e": 47.0}, {"w": " j", "s": 47.0, "e": 47.12}, {"w": "'en", "s": 47.12, "e": 47.28}, {"w": " reprends,", "s": 47.28, "e": 47.68}, {"w": " ça", "s": 47.74, "e": 48.0}, {"w": " pue", "s": 48.0, "e": 48.1}, {"w": " la", "s": 48.1, "e": 48.3}, {"w": " mort", "s": 48.3, "e": 48.44}, {"w": " ce", "s": 48.44, "e": 48.66}, {"w": " truc.", "s": 48.66, "e": 48.86}]}, {"start": 49.0, "end": 52.16, "text": " En revanche, le canard sur Excalibur était divin.", "words": [{"w": " En", "s": 49.0, "e": 49.24}, {"w": " revanche,", "s": 49.24, "e": 49.58}, {"w": " le", "s": 49.72, "e": 49.92}, {"w": " canard", "s": 49.92, "e": 50.18}, {"w": " sur", "s": 50.18, "e": 50.46}, {"w": " Excalibur", "s": 50.46, "e": 51.08}, {"w": " était", "s": 51.08, "e": 51.5}, {"w": " divin.", "s": 51.5, "e": 52.16}]}, {"start": 52.24, "end": 55.5, "text": " J'ai aussi pris des œufs aux cèpes et un os à la moelle épinière.", "words": [{"w": " J", "s": 52.24, "e": 52.36}, {"w": "'ai", "s": 52.36, "e": 52.44}, {"w": " aussi", "s": 52.44, "e": 52.66}, {"w": " pris", "s": 52.66, "e": 52.8}, {"w": " des", "s": 52.8, "e": 53.1}, {"w": " œufs", "s": 53.1, "e": 53.26}, {"w": " aux", "s": 53.26, "e": 53.48}, {"w": " cèpes", "s": 53.48, "e": 53.78}, {"w": " et", "s": 53.78, "e": 53.96}, {"w": " un", "s": 53.96, "e": 54.24}, {"w": " os", "s": 54.24, "e": 54.4}, {"w": " à", "s": 54.4, "e": 54.64}, {"w": " la", "s": 54.64, "e": 54.86}, {"w": " moelle", "s": 54.86, "e": 55.04}, {"w": " épinière.", "s": 55.04, "e": 55.5}]}, {"start": 55.5, "end": 56.4, "text": " Un vrai festin.", "words": [{"w": " Un", "s": 55.5, "e": 55.78}, {"w": " vrai", "s": 55.78, "e": 56.02}, {"w": " festin.", "s": 56.02, "e": 56.4}]}, {"start": 56.52, "end": 60.32, "text": " Les plus fragiles ont déjà pris un chaos technique, tombé au champ d'honneur, mais", "words": [{"w": " Les", "s": 56.52, "e": 56.58}, {"w": " plus", "s": 56.58, "e": 56.76}, {"w": " fragiles", "s": 56.76, "e": 57.18}, {"w": " ont", "s": 57.18, "e": 57.36}, {"w": " déjà", "s": 57.36, "e": 57.68}, {"w": " pris", "s": 57.68, "e": 57.84}, {"w": " un", "s": 57.84, "e": 58.1}, {"w": " chaos", "s": 58.1, "e": 58.26}, {"w": " technique,", "s": 58.26, "e": 58.74}, {"w": " tombé", "s": 58.98, "e": 59.26}, {"w": " au", "s": 59.26, "e": 59.5}, {"w": " champ", "s": 59.5, "e": 59.64}, {"w": " d", "s": 59.64, "e": 59.86}, {"w": "'honneur,", "s": 59.86, "e": 60.08}, {"w": " mais", "s": 60.2, "e": 60.32}]}, {"start": 60.32, "end": 61.24, "text": " la quête continue.", "words": [{"w": " la", "s": 60.32, "e": 60.54}, {"w": " quête", "s": 60.54, "e": 60.86}, {"w": " continue.", "s": 60.86, "e": 61.24}]}, {"start": 61.36, "end": 65.18, "text": " J'ai pas pu goûter à tout, hélas, mais les crêpes Suzette sont clairement bénis", "words": [{"w": " J", "s": 61.36, "e": 61.4}, {"w": "'ai", "s": 61.4, "e": 61.5}, {"w": " pas", "s": 61.5, "e": 61.64}, {"w": " pu", "s": 61.64, "e": 61.7}, {"w": " goûter", "s": 61.7, "e": 62.02}, {"w": " à", "s": 62.02, "e": 62.22}, {"w": " tout,", "s": 62.22, "e": 62.36}, {"w": " hélas,", "s": 62.52, "e": 62.9}, {"w": " mais", "s": 63.12, "e": 63.22}, {"w": " les", "s": 63.22, "e": 63.46}, {"w": " crêpes", "s": 63.46, "e": 63.74}, {"w": " Suzette", "s": 63.74, "e": 64.12}, {"w": " sont", "s": 64.12, "e": 64.46}, {"w": " clairement", "s": 64.46, "e": 64.88}, {"w": " bénis", "s": 64.88, "e": 65.18}]}, {"start": 65.18, "end": 65.48, "text": " des dieux.", "words": [{"w": " des", "s": 65.18, "e": 65.34}, {"w": " dieux.", "s": 65.34, "e": 65.48}]}, {"start": 65.62, "end": 67.98, "text": " Le calenet était pas ouf, mais pas de gâchis dans ce royaume.", "words": [{"w": " Le", "s": 65.62, "e": 65.76}, {"w": " calenet", "s": 65.76, "e": 66.1}, {"w": " était", "s": 66.1, "e": 66.26}, {"w": " pas", "s": 66.26, "e": 66.5}, {"w": " ouf,", "s": 66.5, "e": 66.8}, {"w": " mais", "s": 66.94, "e": 67.02}, {"w": " pas", "s": 67.02, "e": 67.12}, {"w": " de", "s": 67.12, "e": 67.26}, {"w": " gâchis", "s": 67.26, "e": 67.5}, {"w": " dans", "s": 67.5, "e": 67.64}, {"w": " ce", "s": 67.64, "e": 67.76}, {"w": " royaume.", "s": 67.76, "e": 67.98}]}, {"start": 68.08, "end": 70.28, "text": " Tel un héros, le gagnant gardera son anonyme.", "words": [{"w": " Tel", "s": 68.08, "e": 68.18}, {"w": " un", "s": 68.18, "e": 68.4}, {"w": " héros,", "s": 68.4, "e": 68.74}, {"w": " le", "s": 68.88, "e": 69.02}, {"w": " gagnant", "s": 69.02, "e": 69.3}, {"w": " gardera", "s": 69.3, "e": 69.72}, {"w": " son", "s": 69.72, "e": 69.88}, {"w": " anonyme.", "s": 69.88, "e": 70.28}]}, {"start": 70.34, "end": 73.8, "text": " On peut retourner repus dans la meilleure ville de France, le ventre plein et", "words": [{"w": " On", "s": 70.34, "e": 70.48}, {"w": " peut", "s": 70.48, "e": 70.7}, {"w": " retourner", "s": 70.7, "e": 71.24}, {"w": " repus", "s": 71.24, "e": 71.68}, {"w": " dans", "s": 71.68, "e": 71.86}, {"w": " la", "s": 71.86, "e": 72.04}, {"w": " meilleure", "s": 72.04, "e": 72.24}, {"w": " ville", "s": 72.24, "e": 72.34}, {"w": " de", "s": 72.34, "e": 72.64}, {"w": " France,", "s": 72.64, "e": 72.8}, {"w": " le", "s": 72.94, "e": 73.08}, {"w": " ventre", "s": 73.08, "e": 73.46}, {"w": " plein", "s": 73.46, "e": 73.58}, {"w": " et", "s": 73.58, "e": 73.8}]}, {"start": 73.8, "end": 74.38, "text": " l'honneur s'offre.", "words": [{"w": " l", "s": 73.8, "e": 73.88}, {"w": "'honneur", "s": 73.88, "e": 74.18}, {"w": " s", "s": 74.18, "e": 74.28}, {"w": "'offre.", "s": 74.28, "e": 74.38}]}]