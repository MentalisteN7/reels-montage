[{"start": 0.0, "end": 4.44, "text": " Le meilleur sushi à volonté de Toulouse vient d'ouvrir et c'est vraiment pas cher.", "words": [{"w": " Le", "s": 0.0, "e": 0.3}, {"w": " meilleur", "s": 0.3, "e": 0.66}, {"w": " sushi", "s": 0.66, "e": 1.12}, {"w": " à", "s": 1.12, "e": 1.34}, {"w": " volonté", "s": 1.34, "e": 1.86}, {"w": " de", "s": 1.86, "e": 2.1}, {"w": " Toulouse", "s": 2.1, "e": 2.44}, {"w": " vient", "s": 2.44, "e": 2.74}, {"w": " d", "s": 2.74, "e": 2.88}, {"w": "'ouvrir", "s": 2.88, "e": 3.22}, {"w": " et", "s": 3.22, "e": 3.46}, {"w": " c", "s": 3.46, "e": 3.62}, {"w": "'est", "s": 3.62, "e": 3.76}, {"w": " vraiment", "s": 3.76, "e": 4.04}, {"w": " pas", "s": 4.04, "e": 4.24}, {"w": " cher.", "s": 4.24, "e": 4.44}]}, {"start": 4.56, "end": 8.82, "text": " A deux pas de Jean Jaurès, chez Matsuya, pour seulement 20€, les chefs nous préparent", "words": [{"w": " A", "s": 4.56, "e": 4.7}, {"w": " deux", "s": 4.7, "e": 4.88}, {"w": " pas", "s": 4.88, "e": 5.02}, {"w": " de", "s": 5.02, "e": 5.26}, {"w": " Jean", "s": 5.26, "e": 5.4}, {"w": " Jaurès,", "s": 5.4, "e": 5.8}, {"w": " chez", "s": 5.92, "e": 6.08}, {"w": " Matsuya,", "s": 6.08, "e": 6.68}, {"w": " pour", "s": 6.82, "e": 6.98}, {"w": " seulement", "s": 6.98, "e": 7.44}, {"w": " 20€,", "s": 7.44, "e": 7.94}, {"w": " les", "s": 7.98, "e": 8.2}, {"w": " chefs", "s": 8.2, "e": 8.4}, {"w": " nous", "s": 8.4, "e": 8.58}, {"w": " préparent", "s": 8.58, "e": 8.82}]}, {"start": 8.82, "end": 10.6, "text": " des sushis élaborés et excellents.", "words": [{"w": " des", "s": 8.82, "e": 9.0}, {"w": " sushis", "s": 9.0, "e": 9.42}, {"w": " élaborés", "s": 9.42, "e": 9.96}, {"w": " et", "s": 9.96, "e": 10.4}, {"w": " excellents.", "s": 10.4, "e": 10.6}]}, {"start": 10.64, "end": 14.54, "text": " Si ce prix d'ouverture reste à 20€, ça va clairement devenir mon resto favori.", "words": [{"w": " Si", "s": 10.64, "e": 10.74}, {"w": " ce", "s": 10.74, "e": 10.88}, {"w": " prix", "s": 10.88, "e": 11.1}, {"w": " d", "s": 11.1, "e": 11.18}, {"w": "'ouverture", "s": 11.18, "e": 11.68}, {"w": " reste", "s": 11.68, "e": 11.92}, {"w": " à", "s": 11.92, "e": 12.04}, {"w": " 20€,", "s": 12.04, "e": 12.46}, {"w": " ça", "s": 12.5, "e": 12.6}, {"w": " va", "s": 12.6, "e": 12.84}, {"w": " clairement", "s": 12.84, "e": 13.16}, {"w": " devenir", "s": 13.16, "e": 13.46}, {"w": " mon", "s": 13.46, "e": 13.64}, {"w": " resto", "s": 13.64, "e": 14.06}, {"w": " favori.", "s": 14.06, "e": 14.54}]}, {"start": 14.6, "end": 17.78, "text": " Salut, moi c'est Harry, l'influenceur en carton, et cette semaine, on part tester", "words": [{"w": " Salut,", "s": 14.6, "e": 14.8}, {"w": " moi", "s": 14.9, "e": 15.08}, {"w": " c", "s": 15.08, "e": 15.18}, {"w": "'est", "s": 15.18, "e": 15.26}, {"w": " Harry,", "s": 15.26, "e": 15.42}, {"w": " l", "s": 15.58, "e": 15.7}, {"w": "'influenceur", "s": 15.7, "e": 16.04}, {"w": " en", "s": 16.04, "e": 16.18}, {"w": " carton,", "s": 16.18, "e": 16.42}, {"w": " et", "s": 16.54, "e": 16.74}, {"w": " cette", "s": 16.74, "e": 16.92}, {"w": " semaine,", "s": 16.92, "e": 17.18}, {"w": " on", "s": 17.32, "e": 17.38}, {"w": " part", "s": 17.38, "e": 17.54}, {"w": " tester", "s": 17.54, "e": 17.78}]}, {"start": 17.78, "end": 18.7, "text": " la pépite de l'année.", "words": [{"w": " la", "s": 17.78, "e": 18.02}, {"w": " pépite", "s": 18.02, "e": 18.38}, {"w": " de", "s": 18.38, "e": 18.58}, {"w": " l", "s": 18.58, "e": 18.62}, {"w": "'année.", "s": 18.62, "e": 18.7}]}, {"start": 18.82, "end": 21.92, "text": " On est accueillis par un petit robot qui nous apporte à boire et à manger.", "words": [{"w": " On", "s": 18.82, "e": 18.86}, {"w": " est", "s": 18.86, "e": 19.08}, {"w": " accueillis", "s": 19.08, "e": 19.36}, {"w": " par", "s": 19.36, "e": 19.54}, {"w": " un", "s": 19.54, "e": 19.76}, {"w": " petit", "s": 19.76, "e": 20.02}, {"w": " robot", "s": 20.02, "e": 20.26}, {"w": " qui", "s": 20.26, "e": 20.42}, {"w": " nous", "s": 20.42, "e": 20.62}, {"w": " apporte", "s": 20.62, "e": 20.98}, {"w": " à", "s": 20.98, "e": 21.2}, {"w": " boire", "s": 21.2, "e": 21.46}, {"w": " et", "s": 21.46, "e": 21.6}, {"w": " à", "s": 21.6, "e": 21.74}, {"w": " manger.", "s": 21.74, "e": 21.92}]}, {"start": 22.06, "end": 23.08, "text": " Bienvenue dans le futur.", "words": [{"w": " Bienvenue", "s": 22.06, "e": 22.46}, {"w": " dans", "s": 22.46, "e": 22.74}, {"w": " le", "s": 22.74, "e": 22.86}, {"w": " futur.", "s": 22.86, "e": 23.08}]}, {"start": 23.16, "end": 26.08, "text": " Pour commander, tout se passe sur la tablette, c'est vraiment intuitif.", "words": [{"w": " Pour", "s": 23.16, "e": 23.32}, {"w": " commander,", "s": 23.32, "e": 23.74}, {"w": " tout", "s": 23.82, "e": 23.92}, {"w": " se", "s": 23.92, "e": 24.18}, {"w": " passe", "s": 24.18, "e": 24.34}, {"w": " sur", "s": 24.34, "e": 24.68}, {"w": " la", "s": 24.68, "e": 24.88}, {"w": " tablette,", "s": 24.88, "e": 25.16}, {"w": " c", "s": 25.2, "e": 25.32}, {"w": "'est", "s": 25.32, "e": 25.38}, {"w": " vraiment", "s": 25.38, "e": 25.7}, {"w": " intuitif.", "s": 25.7, "e": 26.08}]}, {"start": 26.08, "end": 28.9, "text": " Mon top 3, ça commence clairement avec ce temaki.", "words": [{"w": " Mon", "s": 26.08, "e": 26.32}, {"w": " top", "s": 26.32, "e": 26.58}, {"w": " 3,", "s": 26.58, "e": 26.86}, {"w": " ça", "s": 26.88, "e": 27.06}, {"w": " commence", "s": 27.06, "e": 27.46}, {"w": " clairement", "s": 27.46, "e": 27.92}, {"w": " avec", "s": 27.92, "e": 28.3}, {"w": " ce", "s": 28.3, "e": 28.54}, {"w": " temaki.", "s": 28.54, "e": 28.9}]}, {"start": 29.06, "end": 30.74, "text": " Celui épicé était trop bon.", "words": [{"w": " Celui", "s": 29.06, "e": 29.42}, {"w": " épicé", "s": 29.42, "e": 30.02}, {"w": " était", "s": 30.02, "e": 30.36}, {"w": " trop", "s": 30.36, "e": 30.7}, {"w": " bon.", "s": 30.7, "e": 30.74}]}, {"start": 30.84, "end": 34.4, "text": " J'ai aussi pris des californias au saumon et à la mangue, je crois en avoir mangé", "words": [{"w": " J", "s": 30.84, "e": 30.92}, {"w": "'ai", "s": 30.92, "e": 31.02}, {"w": " aussi", "s": 31.02, "e": 31.22}, {"w": " pris", "s": 31.22, "e": 31.36}, {"w": " des", "s": 31.36, "e": 31.56}, {"w": " californias", "s": 31.56, "e": 32.16}, {"w": " au", "s": 32.16, "e": 32.36}, {"w": " saumon", "s": 32.36, "e": 32.64}, {"w": " et", "s": 32.64, "e": 32.82}, {"w": " à", "s": 32.82, "e": 32.94}, {"w": " la", "s": 32.94, "e": 33.12}, {"w": " mangue,", "s": 33.12, "e": 33.38}, {"w": " je", "s": 33.52, "e": 33.62}, {"w": " crois", "s": 33.62, "e": 33.74}, {"w": " en", "s": 33.74, "e": 33.88}, {"w": " avoir", "s": 33.88, "e": 34.02}, {"w": " mangé", "s": 34.02, "e": 34.4}]}, {"start": 34.4, "end": 34.9, "text": " au moins 12.", "words": [{"w": " au", "s": 34.4, "e": 34.54}, {"w": " moins", "s": 34.54, "e": 34.7}, {"w": " 12.", "s": 34.7, "e": 34.9}]}, {"start": 35.02, "end": 37.64, "text": " Enfin, ces gyoza frits étaient exceptionnels.", "words": [{"w": " Enfin,", "s": 35.02, "e": 35.42}, {"w": " ces", "s": 35.58, "e": 35.68}, {"w": " gyoza", "s": 35.68, "e": 36.18}, {"w": " frits", "s": 36.18, "e": 36.42}, {"w": " étaient", "s": 36.42, "e": 36.9}, {"w": " exceptionnels.", "s": 36.9, "e": 37.64}]}, {"start": 37.84, "end": 40.72, "text": " Ah oui, pensez à prendre le sashimi de saumon, il était incroyable.", "words": [{"w": " Ah", "s": 37.84, "e": 37.86}, {"w": " oui,", "s": 37.86, "e": 38.04}, {"w": " pensez", "s": 38.24, "e": 38.46}, {"w": " à", "s": 38.46, "e": 38.54}, {"w": " prendre", "s": 38.54, "e": 38.62}, {"w": " le", "s": 38.62, "e": 38.9}, {"w": " sashimi", "s": 38.9, "e": 39.28}, {"w": " de", "s": 39.28, "e": 39.48}, {"w": " saumon,", "s": 39.48, "e": 39.76}, {"w": " il", "s": 39.82, "e": 39.94}, {"w": " était", "s": 39.94, "e": 40.2}, {"w": " incroyable.", "s": 40.2, "e": 40.72}]}]